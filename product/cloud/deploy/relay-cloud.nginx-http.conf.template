# Temporary ACME bootstrap virtual host for the Relay control plane.
# Replace with relay-cloud.nginx.conf after the certificate is issued.

server {
    listen 80;
    listen [::]:80;
    server_name __RELAY_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
