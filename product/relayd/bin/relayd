#!/usr/bin/env node
// relayd CLI — W2-MODULES. Subcommands:
//   run [--mode <mode>]       start the node daemon (direct|tunneled|both)
//   pair [--no-qr]            print a single-use pairing QR + code + URLs
//   doctor                    config / jail / identity / provider checks
//   status                    query the running daemon's /healthz
//   devices list              list enrolled devices
//   devices revoke <id|serial> [--force]
//   update --check            print the running build and the announced release
//   update --file <tarball>   apply a local signed artifact
//   update --now              apply without waiting for the node to go idle
//   update --pin <version> | --unpin
//
// Everything is stdlib-only. The CLI never prints secret material: pairing
// codes/tokens are the one deliberate exception (they ARE the credential the
// user must transfer to the phone, single-use, 15-minute TTL).

import http from "node:http";
import net from "node:net";
import fs from "node:fs";
import path from "node:path";

const [, , command, ...rest] = process.argv;

function fail(message, code = 1) {
  console.error(`relayd: ${message}`);
  process.exit(code);
}

function ok(label, detail = "") {
  console.log(`  [ok]   ${label}${detail ? ` — ${detail}` : ""}`);
}

function bad(label, detail = "") {
  console.log(`  [FAIL] ${label}${detail ? ` — ${detail}` : ""}`);
}

function warn(label, detail = "") {
  console.log(`  [warn] ${label}${detail ? ` — ${detail}` : ""}`);
}

const LISTEN_MODES = ["direct", "tunneled", "both"];

// `relayd run [--mode direct|tunneled|both]` — the flag is a convenience
// override for RELAYD_LISTEN_MODE; config.mjs remains the single source of
// truth (and validates it).
async function cmdRun(args) {
  const index = args.findIndex((arg) => arg === "--mode" || arg.startsWith("--mode="));
  if (index !== -1) {
    const arg = args[index];
    const value = arg.includes("=") ? arg.slice(arg.indexOf("=") + 1) : args[index + 1];
    if (!value || !LISTEN_MODES.includes(value)) {
      fail(`--mode must be one of ${LISTEN_MODES.join("|")}`);
    }
    process.env.RELAYD_LISTEN_MODE = value;
  }
  await import("../src/index.mjs");
}

// Mints a pairing session INTO THE SHARED STORE, so the already-running
// daemon (a different process) can redeem the printed code. Prints the QR the
// phone scans, the typed fallback code, the address the phone POSTs /v1/pair
// to, and the CA pin the phone will check that connection against.
// The pairing code/token is the one deliberate secret this CLI prints — it IS
// the credential the user carries to the phone. No key material is ever shown.
async function cmdPair(args = []) {
  const config = await import("../src/config.mjs");
  const identity = await import("../src/identity.mjs");
  const pairing = await import("../src/pairing.mjs");
  const { renderQrAnsi, qrAnsiWidth } = await import("../src/qr.mjs");
  identity.initIdentity();
  const session = pairing.createPairingSession();
  const presented = pairing.pairingPresentation(session);
  const noQr = args.includes("--no-qr");

  // QR above the human code, exactly as `relay login` does it. Skipped when
  // asked, when stdout is not a TTY (a piped symbol is noise), or when the
  // terminal is narrower than the symbol — wrapping breaks the finder patterns
  // and no camera can lock onto it. Terminal.app can leave seams between the
  // Unicode half-block glyphs, so it gets the wider font-independent renderer
  // when that one fits.
  console.log("");
  if (!noQr && process.stdout.isTTY) {
    const columns = process.stdout.columns;
    const preferred = process.env.TERM_PROGRAM === "Apple_Terminal" ? "square" : "compact";
    const fits = (mode) => columns == null || columns >= qrAnsiWidth(presented.url, { mode });
    const mode = fits(preferred) ? preferred : fits("compact") ? "compact" : null;
    if (mode) {
      console.log(renderQrAnsi(presented.url, { mode }));
      console.log("");
      console.log("  Scan this with the Relay app.");
      console.log("");
    }
  }

  // What actually pairs is the QR (or the token pasted from the Link below).
  // The short code is NOT a credential and cannot redeem this session: every
  // key in the protocol is derived from the token, so a caller holding only the
  // code cannot produce a blob the node will accept. It exists to be COMPARED —
  // the app shows the same eight characters once the exchange completes.
  console.log("Scan the QR above with the Relay app, or paste the Link below.");
  console.log("");
  console.log("Confirmation code — check the app shows exactly this:");
  console.log("");
  console.log(`    ${presented.code}`);
  console.log("");
  console.log("This code is not typed in anywhere. It is single use and expires in 15 minutes.");
  console.log("");
  console.log(`  Pair at: ${presented.pairUrl}`);
  console.log(`  Machine: ${presented.apiBaseUrl}`);
  console.log(`  Link:    ${presented.url}`);
  console.log(`  otpauth: ${presented.otpauthUrl}`);
  if (presented.caFingerprint) {
    // The phone shows this before it sends anything. Two screens, one human,
    // one comparison — that is what makes a self-signed node safe to trust.
    console.log(`  CA pin:  ${presented.caFingerprint}`);
  }
  console.log(`  Expires: ${presented.expiresAt}`);
  console.log("");
  if (!presented.pairListenerEnabled) {
    console.log("WARNING: RELAYD_PAIRING_ENABLED=false — the daemon serves no");
    console.log("pairing listener, so this code cannot be redeemed. Enable it and");
    console.log("restart relayd.");
  } else if (presented.pairListenerLoopbackOnly) {
    console.log(`NOTE: the pairing listener is bound to ${config.pairingHost} (loopback), so the`);
    console.log("phone cannot reach it directly. Expose it through the gateway or an");
    console.log("SSH tunnel, or set RELAYD_PAIRING_HOST / RELAYD_PAIRING_ADVERTISE.");
  }
  console.log("");
  console.log("The session is persisted, so the running daemon redeems it — you do");
  console.log("not need to keep this command open.");
}

async function cmdDoctor() {
  let failures = 0;
  console.log("relayd doctor");

  // Node runtime.
  const major = Number(process.versions.node.split(".")[0]);
  if (major >= 22) ok("node runtime", `v${process.versions.node}`);
  else {
    bad("node runtime", `v${process.versions.node} (need >= 22 for node:sqlite)`);
    failures += 1;
  }

  // Config (evaluating it validates every env knob and creates the data dirs).
  let config = null;
  try {
    config = await import("../src/config.mjs");
    ok("config", `dataDir=${config.dataDir}`);
  } catch (error) {
    bad("config", error.message);
    failures += 1;
  }

  if (config) {
    // Snapshot the server certificate BEFORE the direct-TLS check below, which
    // calls nodeServerTlsOptions() and so reissues a stale leaf as a side
    // effect. Read afterwards, this would always show the repaired certificate
    // and never the problem the user is calling about.
    const serverCertBefore = config.externalTlsConfigured
      ? null
      : (await import("../src/identity.mjs")).serverCertStatus();

    // Listen mode. Tunneled mode needs a broker endpoint and an initialized
    // identity; direct mode needs neither.
    ok("listen mode", config.listenMode);
    if (config.listensDirect) {
      ok("direct listener", `${config.servesTls ? "https" : "http"}://${config.host}:${config.port}`);
    }
    if (config.listensTunneled) {
      if (config.tunnelHost) {
        const identityModule = await import("../src/identity.mjs");
        const nodeId = identityModule.readNodeId(identityModule.identityPaths());
        const sni = config.tunnelSni || (nodeId ? `${nodeId}${config.tunnelSuffix}` : `<node-id>${config.tunnelSuffix}`);
        ok("tunnel broker", `${config.tunnelHost}:${config.tunnelPort} sni=${sni}`);
        if (!nodeId) {
          bad("tunnel identity", "node identity is not initialized (run `relayd pair` once)");
          failures += 1;
        }
      } else {
        bad("tunnel broker", "RELAYD_TUNNEL_HOST is required for tunneled listen mode");
        failures += 1;
      }
    }

    // Pairing listener: the onboarding path. A disabled listener means every
    // code `relayd pair` prints is unredeemable, which is a hard failure.
    if (config.pairingEnabled) {
      ok("pairing listener", `${config.pairingEndpointUrl()}${config.pairingIsLoopbackOnly() ? " (loopback only)" : ""}`);
      if (config.pairingIsLoopbackOnly()) {
        warn("pairing reachability", "bound to loopback — expose via the gateway or set RELAYD_PAIRING_HOST/ADVERTISE");
      }
    } else {
      bad("pairing listener", "RELAYD_PAIRING_ENABLED=false — `relayd pair` codes cannot be redeemed");
      failures += 1;
    }

    // Direct TLS. A BYO node is expected to serve its own certificate; the
    // phone validates it against the CA pin carried in the QR, so the two must
    // agree — a certificate that does not cover the advertised host makes every
    // pairing fail with an error the user cannot act on.
    if (config.listensDirect) {
      const advertised = config.apiBaseUrl();
      if (!config.servesTls) {
        warn(
          "direct TLS",
          "RELAYD_DIRECT_TLS=false — the data listener is plain HTTP and only works behind a TLS-terminating proxy",
        );
      } else if (config.externalTlsConfigured) {
        ok("direct TLS", `operator certificate from ${config.tlsCertFile}`);
      } else {
        try {
          const identityModule = await import("../src/identity.mjs");
          const issued = identityModule.nodeServerTlsOptions();
          const wanted = identityModule.sanEntry(new URL(advertised).hostname);
          if (issued.sans && wanted && !issued.sans.includes(wanted)) {
            bad(
              "direct TLS",
              `server certificate covers ${issued.sans.join(", ")} but the QR advertises ${wanted} — set RELAYD_PUBLIC_HOST`,
            );
            failures += 1;
          } else {
            ok("direct TLS", `node-signed, SAN ${(issued.sans || []).join(", ")}`);
          }
          const pin = identityModule.caSpkiFingerprint();
          if (pin) ok("CA pin", `${pin} (compare with the app during pairing)`);
          else {
            bad("CA pin", "node CA is missing — run `relayd pair` once");
            failures += 1;
          }
        } catch (error) {
          bad("direct TLS", error.message);
          failures += 1;
        }
      }
      ok("advertised URL", advertised);

      // Reachability. This can only ever be answered for the hop this machine
      // can make itself; a firewall between the phone and this VM is invisible
      // from here, so say that rather than implying a clean bill of health.
      const target = new URL(advertised);
      const probeHost = target.hostname.replace(/^\[|\]$/g, "");
      const probePort = Number(target.port) || (target.protocol === "https:" ? 443 : 80);
      const reachable = await new Promise((resolve) => {
        const socket = net.connect({ host: probeHost, port: probePort, timeout: 1500 });
        const done = (value) => {
          socket.destroy();
          resolve(value);
        };
        socket.once("connect", () => done(true));
        socket.once("timeout", () => done(false));
        socket.once("error", () => done(false));
      });
      if (reachable) {
        warn(
          "advertised port reachable",
          `${probeHost}:${probePort} accepted a connection from this machine — this cannot tell you whether a firewall blocks the phone`,
        );
      } else {
        warn(
          "advertised port reachable",
          `nothing is listening on ${probeHost}:${probePort} from this machine (relayd may simply not be running yet)`,
        );
      }
    }

    // Browser grants. Optional; the web activity page is the only consumer.
    if (config.grantPublicKey) ok("browser grants", "RELAYD_GRANT_PUBLIC_KEY is set");
    else warn("browser grants", "RELAYD_GRANT_PUBLIC_KEY unset — the web activity page is unavailable (pairing is unaffected)");

    // Client-cert allowlist. Empty + auto-allow off + mTLS on = every device
    // 403s forever, which is the other half of the onboarding dead end.
    if (config.requireMtls && config.allowedCertSubjects.size === 0 && !config.pairingAutoAllow) {
      bad(
        "cert subject allowlist",
        "empty with RELAYD_PAIRING_AUTOALLOW=false and mTLS required — no device can ever be authorized",
      );
      failures += 1;
    } else {
      ok(
        "cert subject allowlist",
        `${config.allowedCertSubjects.size} subject(s), autoallow=${config.pairingAutoAllow}`,
      );
    }

    // Data dir writable.
    try {
      const probe = path.join(config.dataDir, `.doctor-${process.pid}`);
      fs.writeFileSync(probe, "ok");
      fs.rmSync(probe);
      ok("data dir writable", config.dataDir);
    } catch (error) {
      bad("data dir writable", error.message);
      failures += 1;
    }

    // Workspace jail sanity: root exists and realpath-resolves to itself.
    try {
      const real = fs.realpathSync(config.workspaceBrowseRoot);
      if (real === config.workspaceBrowseRoot) ok("workspace jail root", real);
      else warn("workspace jail root", `configured ${config.workspaceBrowseRoot} resolves to ${real}`);
    } catch (error) {
      bad("workspace jail root", `${config.workspaceBrowseRoot}: ${error.message}`);
      failures += 1;
    }

    // Store backend.
    try {
      const { store, storeKind } = await import("../src/store.mjs");
      store.listDevices();
      ok("store", storeKind);
    } catch (error) {
      bad("store", error.message);
      failures += 1;
    }

    // Identity / openssl.
    try {
      const identity = await import("../src/identity.mjs");
      const version = identity.opensslVersion();
      if (version) ok("openssl", version);
      else {
        bad("openssl", "binary not found (required for pairing/cert issuance)");
        failures += 1;
      }
      const status = identity.identityStatus();
      if (status.hasCa && status.hasIdentityKey) {
        ok("identity", `nodeId=${status.nodeId} devices=${status.deviceCount} revoked=${status.revokedCount}`);
      } else {
        warn("identity", "not initialized yet (run `relayd pair` once to create it)");
      }
      // The X25519 key `relay handoff` seals to. Pairing is now the only way a
      // phone learns it, and a node without one silently cannot be handed off
      // to — so it is called out rather than left to be discovered.
      if (status.hasEncKey) ok("handoff key", "X25519 keypair present");
      else warn("handoff key", "no X25519 keypair — this node cannot receive `relay handoff` sessions");

      // The served leaf, read the way an iPhone reads it.
      //
      // Apple refuses a TLS server certificate whose validity period exceeds
      // 398 days, and refuses it during trust evaluation — so the phone shows
      // a bare TLS error while curl, openssl and Node all connect happily.
      // Every other check in this command can pass with such a certificate in
      // place, which is precisely how it cost two separate people a debugging
      // session. Say it out loud instead.
      if (config.externalTlsConfigured) {
        ok("server certificate", "supplied by the operator (RELAYD_TLS_CERT_FILE) — relayd does not manage it");
      } else {
        const cert = serverCertBefore || { present: false };
        if (!cert.present) {
          warn("server certificate", `none issued yet for ${config.publicHost} (the first listener start creates it)`);
        } else if (!cert.readable) {
          bad("server certificate", `${cert.certPath} cannot be parsed (${cert.error}) — restart relayd to reissue it`);
          failures += 1;
        } else if (cert.expired) {
          bad("server certificate", `expired ${cert.validTo} — restart relayd so it reissues and serves a fresh one`);
          failures += 1;
        } else if (cert.overAppleLimit) {
          bad(
            "server certificate",
            `${cert.days} days of validity exceeds the 398 Apple allows, so every iPhone will refuse this machine ` +
              "with a bare TLS error — restart relayd so it reissues and serves a fresh one",
          );
          failures += 1;
        } else {
          ok("server certificate", `${cert.days} days, ${cert.sans || "no SANs"}`);
        }
      }
    } catch (error) {
      bad("identity", error.message);
      failures += 1;
    }

    // Host usage sampler — the phone's Usage screen reads this from the node.
    try {
      const { createHostMonitor } = await import("../src/hoststats.mjs");
      const monitor = createHostMonitor({
        setIntervalFn: () => ({ unref() {} }),
        clearIntervalFn: () => {},
      });
      const snap = monitor.snapshot();
      monitor.stop();
      if (snap?.ok) ok("host usage", snap.host?.hostname || "sampler ready");
      else {
        bad("host usage", "sampler did not produce a snapshot");
        failures += 1;
      }
    } catch (error) {
      bad("host usage", error.message);
      failures += 1;
    }

    // Provider CLIs (informational — a missing harness is not a failure).
    try {
      const harness = await import("../src/harness.mjs");
      for (const entry of harness.listHarnesses()) {
        if (entry.installed) ok(`harness ${entry.provider}`, entry.version || "installed");
        else warn(`harness ${entry.provider}`, "not installed");
      }
    } catch (error) {
      bad("harness detection", error.message);
      failures += 1;
    }
  }

  console.log(failures === 0 ? "doctor: all checks passed" : `doctor: ${failures} check(s) FAILED`);
  process.exit(failures === 0 ? 0 : 1);
}

async function cmdStatus() {
  let config;
  try {
    config = await import("../src/config.mjs");
  } catch (error) {
    fail(`config error: ${error.message}`);
    return;
  }
  // The build identity of THIS checkout/install, printed before the probe so
  // it is available even when the daemon is not answering — which is exactly
  // when someone is asking what is installed. The daemon's own version comes
  // back inside the /healthz payload below; the two differ precisely when a
  // `current` flip has happened and the service has not been restarted yet.
  const { version, commit, builtAt } = await import("../src/version.mjs");
  console.log(`relayd ${version}${commit ? ` (${commit.slice(0, 12)})` : ""}${builtAt ? ` built ${builtAt}` : ""}`);
  const url = `http://${config.host}:${config.port}/healthz`;
  const payload = await new Promise((resolve) => {
    const request = http.get(url, { timeout: 3000 }, (response) => {
      const chunks = [];
      response.on("data", (chunk) => chunks.push(chunk));
      response.on("end", () => resolve(Buffer.concat(chunks).toString("utf8")));
    });
    request.on("error", () => resolve(null));
    request.on("timeout", () => {
      request.destroy();
      resolve(null);
    });
  });
  if (payload === null) {
    console.log(`relayd: not running (no response from ${url})`);
    process.exit(1);
  }
  console.log(payload);
}

// `relayd update` — the operator's half of the release subscription.
//
// --check is READ-ONLY and, importantly, does not poll the control plane
// itself: pollHandoffs acks every handoff in the response it receives, so a
// CLI poll would confirm delivery of work the daemon never imports. The
// daemon records what it last heard, and this reads that back.
//
// --file applies a local artifact through exactly the same
// verify/stage/drain/flip/verify/rollback path, with no cloud configured at
// all. The signature check is not skipped for a local file.
async function cmdUpdate(args) {
  const flag = (name) => {
    const index = args.findIndex((arg) => arg === `--${name}` || arg.startsWith(`--${name}=`));
    if (index === -1) return undefined;
    const arg = args[index];
    return arg.includes("=") ? arg.slice(arg.indexOf("=") + 1) : args[index + 1];
  };
  const has = (name) => args.some((arg) => arg === `--${name}` || arg.startsWith(`--${name}=`));

  const { createUpdateEngine } = await import("../src/update.mjs");
  const engine = createUpdateEngine();

  if (has("unpin")) {
    const result = engine.unpin();
    console.log(result.version ? `unpinned (was ${result.version})` : "not pinned");
    return;
  }

  if (has("pin")) {
    const value = flag("pin");
    if (!value) fail("usage: relayd update --pin <version>");
    const result = engine.pin(value);
    if (!result.ok) fail(`--pin: ${result.reason}`);
    console.log(`pinned to ${result.version} — announcements for any other version are ignored until \`relayd update --unpin\``);
    return;
  }

  if (has("check") || args.length === 0) {
    const status = engine.status();
    const { version, commit, builtAt } = await import("../src/version.mjs");
    console.log(`running:  ${version}${commit ? ` (${commit.slice(0, 12)})` : ""}${builtAt ? ` built ${builtAt}` : ""}`);
    console.log(`channel:  ${status.channel}`);
    console.log(`auto:     ${status.autoApply ? "on" : "off (RELAYD_AUTO_UPDATE=0)"}`);
    console.log(`layout:   ${status.updateRoot}${status.currentLink ? ` (current -> ${status.currentLink})` : " (no current symlink)"}`);
    console.log(`key:      ${status.publicKeyPresent ? status.publicKeyFile : `MISSING at ${status.publicKeyFile} — no artifact can be verified`}`);
    if (status.pinnedVersion) console.log(`pinned:   ${status.pinnedVersion}`);
    if (status.pendingVersion) console.log(`staged:   ${status.pendingVersion} (awaiting an idle node or a restart)`);
    if (status.announced) {
      const release = status.announced;
      console.log(
        `announced: ${release.channel}/${release.version} seen ${status.announcedSeenAt} — ${status.announcedDecision}` +
          `${release.notes ? `\n           ${release.notes}` : ""}`,
      );
    } else {
      console.log("announced: nothing yet (the daemon records a release the first time a poll carries one)");
    }
    for (const entry of status.poisoned.slice(-5)) {
      console.log(`poisoned:  ${entry.version || entry.sha256} — ${entry.reason} at ${entry.at}`);
    }
    return;
  }

  if (has("file")) {
    const file = flag("file");
    if (!file) fail("usage: relayd update --file <tarball>");
    const resolved = path.resolve(file);
    if (!fs.existsSync(resolved)) fail(`no such artifact: ${resolved}`);
    const result = await engine.applyLocalFile(resolved, { force: has("now") });
    if (!result.ok) {
      fail(`update failed: ${result.reason}${result.rolledBack ? " (rolled back to the previous release)" : ""}`);
    }
    if (result.restarted === false) {
      console.log(`staged and flipped ${result.version}; no supervisor to restart (${result.mode}) — restart relayd to run it`);
      return;
    }
    console.log(`updated to ${result.version}`);
    return;
  }

  fail("usage: relayd update [--check] [--file <tarball>] [--now] [--pin <version>] [--unpin]");
}

async function cmdDevices(args) {
  const identity = await import("../src/identity.mjs");
  const sub = args[0];
  if (sub === "list" || sub === undefined) {
    const devices = identity.listDevices();
    if (devices.length === 0) {
      console.log("no devices enrolled");
      return;
    }
    for (const device of devices) {
      console.log(
        `${device.id}  serial=${device.certSerial}  ${device.revoked ? "REVOKED" : "active "}  ${device.platform}  ${device.name}`,
      );
    }
    return;
  }
  if (sub === "revoke") {
    const target = args[1];
    if (!target) fail("usage: relayd devices revoke <device-id|cert-serial> [--force]");
    const force = args.includes("--force");
    const devices = (await import("../src/store.mjs")).store.listDevices();
    const device = devices.find((entry) => entry.id === target || entry.certSerial === target.toUpperCase());
    if (!device) fail(`no device matches ${target}`, 1);
    try {
      const result = identity.revokeDevice(device.id, { force });
      console.log(`revoked ${device.id} (serial ${device.certSerial}) at ${result.revokedAt}`);
    } catch (error) {
      fail(error.message, 1);
    }
    return;
  }
  fail(`unknown devices subcommand: ${sub}`);
}

const usage = `usage: relayd <command>

  run [--mode direct|tunneled|both]
                               start the node daemon (default: direct, or
                               RELAYD_LISTEN_MODE)
  pair [--no-qr]               print a pairing QR + code (single use, 15 min)
  doctor                       run config/jail/identity/provider checks
  status                       query the running daemon
  devices list                 list enrolled devices
  devices revoke <id|serial>   revoke a device certificate [--force]
  update [--check]             print the running build and the announced release
  update --file <tarball>      apply a local signed artifact (no cloud needed)
                               [--now] skips the wait for the node to go idle
  update --pin <version>       hold this machine at a version
  update --unpin               follow the channel again
`;

switch (command) {
  case "run":
    await cmdRun(rest);
    break;
  case "pair":
    await cmdPair(rest);
    break;
  case "doctor":
    await cmdDoctor();
    break;
  case "status":
    await cmdStatus();
    break;
  case "devices":
    await cmdDevices(rest);
    break;
  case "update":
    await cmdUpdate(rest);
    break;
  case undefined:
  case "help":
  case "--help":
  case "-h":
    console.log(usage);
    break;
  default:
    console.error(usage);
    fail(`unknown command: ${command}`);
}
