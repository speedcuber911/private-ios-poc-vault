# relayd systemd unit — W2-MODULES installer template.
# Installed to /etc/systemd/system/relayd.service by install.sh.
# Configuration lives in /etc/relayd/relayd.env (root:relay 0640). Values there
# are single-quoted (KEY='value') so the same file is valid for this
# EnvironmentFile= and for `. /etc/relayd/relayd.env` in a shell — both strip
# exactly one layer of matching single quotes.
#
# Listen mode comes from that env file (see relayd.config.example.json):
#   RELAYD_LISTEN_MODE=direct    (default) plain listener behind a gateway
#   RELAYD_LISTEN_MODE=tunneled  dial out to RELAYD_TUNNEL_HOST, TLS on-node
#   RELAYD_LISTEN_MODE=both      both listeners at once
# Tunneled mode additionally needs RELAYD_TUNNEL_HOST (+ optional
# RELAYD_TUNNEL_PORT / RELAYD_TUNNEL_SUFFIX / RELAYD_TUNNEL_SNI) and an
# initialized node identity; relayd exits non-zero at startup if either is
# missing, so Restart=on-failure will surface it in the journal.

[Unit]
Description=Relay node daemon (relayd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relay
Group=relay
EnvironmentFile=/etc/relayd/relayd.env
ExecStart=/opt/relayd/node/bin/node /opt/relayd/app/bin/relayd run
Restart=on-failure
RestartSec=3
# relayd closes the tunnel and stops accepting on SIGTERM; bound the wait.
KillSignal=SIGTERM
TimeoutStopSec=10

# Hardening, sized for a machine its owner brought.
#
# ProtectHome/ProtectSystem=strict were written for a multi-tenant trial
# sandbox, where the node was OUR machine running somebody else's agent. That
# model is gone. relayd runs on hardware the user owns, as that user, and the
# entire point is to let their coding agent read and edit their files — a jail
# that hides /home makes the product do nothing, and does it silently: an empty
# file browser and a harness that reports "not logged in" because the
# credentials are in a home the daemon cannot see.
#
# The protections that still cost nothing here are kept. If you are hosting a
# node for someone else, install with RELAYD_RUN_USER=relay and restore
# ProtectHome=true.
NoNewPrivileges=true
ProtectSystem=false
ProtectHome=false
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
