#!/usr/bin/env python3
"""Render owner-specific Codex API env and nginx config from local config."""

from __future__ import annotations

import argparse
import os
import re
from pathlib import Path
from urllib.parse import urlparse


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG = Path("~/.poc-vault/secrets/config.env").expanduser()
DEFAULT_OUTPUT_DIR = ROOT / "build" / "codex-api"
DEFAULT_TEMPLATE = ROOT / "codex-server" / "codex-api-deploy" / "codex-api.nginx.conf.template"


def load_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = os.path.expandvars(os.path.expanduser(value.strip().strip('"').strip("'")))
    return values


def systemd_value(value: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9_./:@,%+=-]*", value):
        return value
    return "'" + value.replace("'", r"'\''") + "'"


def host_from_url(value: str) -> str | None:
    parsed = urlparse(value)
    return parsed.netloc or None


def codex_domain(config: dict[str, str]) -> str:
    explicit = config.get("CODEX_DOMAIN", "").strip()
    if explicit:
        return explicit
    base_url = config.get("POC_VAULT_CODEX_BASE_URL", "").strip()
    if base_url:
        host = host_from_url(base_url)
        if host:
            return host
    domain_root = config.get("DOMAIN_ROOT", "example.com").strip() or "example.com"
    return f"codex.pocs.{domain_root}"


def env_value(config: dict[str, str], name: str, default: str) -> str:
    value = config.get(name)
    return default if value is None or value == "" else value


def render_env(config: dict[str, str], output: Path) -> None:
    workspace_default = (
        '[{"id":"scratch","name":"Scratch","path":"/srv/codex-workspaces/scratch"},'
        '{"id":"poc-vault","name":"POC Vault","path":"/srv/codex-workspaces/poc-vault"},'
        '{"id":"sigiq","name":"SigiQ","path":"/srv/codex-workspaces/sigiq"}]'
    )
    aws_region = env_value(config, "AWS_REGION", env_value(config, "AWS_DEFAULT_REGION", ""))
    aws_default_region = env_value(config, "AWS_DEFAULT_REGION", aws_region)
    pairs = [
        ("CODEX_API_HOST", "127.0.0.1"),
        ("CODEX_API_PORT", "8787"),
        ("CODEX_REQUIRE_MTLS", "true"),
        ("CODEX_ALLOWED_CERT_SUBJECTS", "CN=iphone,CN=parikshit-mac"),
        ("CODEX_DATA_DIR", "/var/lib/codex-api"),
        ("CODEX_BIN", "/usr/bin/codex"),
        ("CLAUDE_BIN", "/usr/bin/claude"),
        ("CLAUDE_CODE_USE_BEDROCK", ""),
        ("CLAUDE_AWS_PROFILE", "sigiq"),
        ("CLAUDE_DEFAULT_MODEL", "sonnet"),
        ("CLAUDE_SONNET_MODEL", "sonnet"),
        ("CLAUDE_OPUS_MODEL", "global.anthropic.claude-opus-4-6-v1"),
        ("CLAUDE_HAIKU_MODEL", "global.anthropic.claude-haiku-4-5-20251001-v1:0"),
        ("AWS_REGION", aws_region),
        ("AWS_DEFAULT_REGION", aws_default_region),
        ("CODEX_RUN_HOME", "/var/lib/codex-api/run-home"),
        ("CODEX_HOME", "/var/lib/codex-api/run-home/.codex"),
        ("CODEX_DANGEROUS_MODE", "true"),
        ("CODEX_MAX_CONCURRENT", "1"),
        ("CODEX_MAX_BODY_BYTES", "31457280"),
        ("CODEX_MAX_JOB_ATTACHMENTS", "6"),
        ("CODEX_MAX_JOB_ATTACHMENT_BYTES", "8388608"),
        ("CODEX_MAX_JOB_ATTACHMENT_TOTAL_BYTES", "18874368"),
        ("CODEX_MAX_TRANSCRIPTION_AUDIO_BYTES", "26214400"),
        ("CODEX_MAX_OUTPUT_BYTES", "5242880"),
        ("CODEX_RESPONSE_OUTPUT_BYTES", "65536"),
        ("CODEX_LIST_OUTPUT_BYTES", "4096"),
        ("CODEX_THREAD_SUMMARY_CHARACTERS", "240"),
        ("CODEX_DEFAULT_TIMEOUT_MS", "600000"),
        ("CODEX_MAX_TIMEOUT_MS", "1800000"),
        ("CODEX_WORKSPACES", workspace_default),
        ("AZURE_SPEECH_ENDPOINT", ""),
        ("AZURE_SPEECH_API_KEY", ""),
        ("AZURE_SPEECH_API_VERSION", "2025-10-15"),
        ("AZURE_SPEECH_TRANSCRIPTION_MODEL", "mai-transcribe-1"),
        ("AZURE_SPEECH_LOCALES", "en"),
    ]
    lines = [
        "# Generated by ops/render-codex-api-config.",
        "# Install to /etc/codex-api.env on the EC2 host. Do not commit real secrets.",
        "",
    ]
    for name, default in pairs:
        lines.append(f"{name}={systemd_value(env_value(config, name, default))}")
    output.write_text("\n".join(lines) + "\n", encoding="utf-8")


def subject_map(subjects: str) -> str:
    entries = [entry.strip() for entry in subjects.split(",") if entry.strip()]
    if not entries:
        entries = ["CN=iphone", "CN=parikshit-mac"]
    return "\n".join(f'    "{entry.replace(chr(34), "_")}" 1;' for entry in entries)


def render_nginx(config: dict[str, str], template: Path, output: Path) -> None:
    tls_dir = env_value(config, "TLS_DIR", "/etc/poc-vault/tls")
    mtls_dir = env_value(config, "CODEX_MTLS_DIR", "/etc/codex-api/mtls")
    host = env_value(config, "CODEX_API_HOST", "127.0.0.1")
    port = env_value(config, "CODEX_API_PORT", "8787")
    allowed_subjects = env_value(config, "CODEX_ALLOWED_CERT_SUBJECTS", "CN=iphone,CN=parikshit-mac")
    rendered = template.read_text(encoding="utf-8")
    replacements = {
        "__CODEX_DOMAIN__": codex_domain(config),
        "__TLS_DIR__": tls_dir.rstrip("/"),
        "__CODEX_MTLS_DIR__": mtls_dir.rstrip("/"),
        "__CODEX_ALLOWED_SUBJECT_MAP__": subject_map(allowed_subjects),
        "__CODEX_API_UPSTREAM__": f"http://{host}:{port}",
    }
    for key, value in replacements.items():
        rendered = rendered.replace(key, value)
    output.write_text(rendered, encoding="utf-8")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    parser.add_argument("--output-dir", type=Path, default=DEFAULT_OUTPUT_DIR)
    parser.add_argument("--nginx-template", type=Path, default=DEFAULT_TEMPLATE)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    config = {**load_env_file(args.config.expanduser()), **os.environ}
    output_dir = args.output_dir.expanduser()
    output_dir.mkdir(parents=True, exist_ok=True)
    env_path = output_dir / "codex-api.env"
    nginx_path = output_dir / "codex-api.nginx.conf"
    render_env(config, env_path)
    render_nginx(config, args.nginx_template.expanduser(), nginx_path)
    print(f"Wrote {env_path}")
    print(f"Wrote {nginx_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
