#!/usr/bin/env python3
"""Render owner-specific Codex API env and nginx config from local config."""

from __future__ import annotations

import argparse
import json
import os
import re
from pathlib import Path
from urllib.parse import urlparse


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG = Path("~/.poc-vault/secrets/config.env").expanduser()
DEFAULT_OUTPUT_DIR = ROOT / "build" / "codex-api"
DEFAULT_TEMPLATE = ROOT / "relay-server" / "codex-api-deploy" / "codex-api.nginx.conf.template"
DEFAULT_OPENCODE_CONFIG = Path("~/.config/opencode/opencode.jsonc").expanduser()


def load_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = os.path.expandvars(os.path.expanduser(value.strip().strip('"').strip("'")))
    return values


def systemd_value(value: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9_./:@,%+=-]*", value):
        return value
    return "'" + value.replace("'", r"'\''") + "'"


def host_from_url(value: str) -> str | None:
    parsed = urlparse(value)
    return parsed.netloc or None


def codex_domain(config: dict[str, str]) -> str:
    explicit = config.get("CODEX_DOMAIN", "").strip()
    if explicit:
        return explicit
    base_url = config.get("POC_VAULT_CODEX_BASE_URL", "").strip()
    if base_url:
        host = host_from_url(base_url)
        if host:
            return host
    domain_root = config.get("DOMAIN_ROOT", "example.com").strip() or "example.com"
    return f"codex.pocs.{domain_root}"


def env_value(config: dict[str, str], name: str, default: str) -> str:
    value = config.get(name)
    return default if value is None or value == "" else value


def model_catalog_default(config: dict[str, str]) -> str:
    opencode_config = Path(env_value(config, "OPENCODE_CONFIG_PATH", str(DEFAULT_OPENCODE_CONFIG))).expanduser()
    opencode_catalog = catalog_from_opencode(opencode_config)
    if opencode_catalog:
        return json.dumps(opencode_catalog, separators=(",", ":"))

    return json.dumps(task_catalog_entries(), separators=(",", ":"))


def catalog_from_opencode(path: Path) -> list[dict]:
    if not path.is_file():
        return []
    config = json.loads(strip_jsonc(path.read_text(encoding="utf-8")))
    providers = config.get("provider", {})
    if not isinstance(providers, dict):
        return []

    catalog: list[dict] = []
    # Azure exposes the same model id (e.g. gpt-4o) across many deployments. Collapse
    # to one visible entry per model id, keeping the highest-priority deployment, so the
    # picker shows "gpt-4o (Azure)" once instead of one row per endpoint. The winner's
    # full id ("<provider_id>/<model_id>") is retained so the server still routes to the
    # right baseURL/key. Priority is set by azure_deployment_rank (prod > dev > config order).
    azure_by_model: dict[str, dict] = {}
    azure_rank: dict[str, tuple[int, int]] = {}
    provider_index = 0
    for provider_id, provider in providers.items():
        if not isinstance(provider_id, str) or not isinstance(provider, dict):
            continue
        npm = provider.get("npm")
        options = provider.get("options", {}) if isinstance(provider.get("options"), dict) else {}
        models = provider.get("models", {}) if isinstance(provider.get("models"), dict) else {}

        if npm == "@ai-sdk/openai-compatible":
            base_url = clean_opencode_url(options.get("baseURL"))
            api_key_file = file_ref_path(options.get("apiKey"))
            if not base_url or not api_key_file:
                continue
            rank = azure_deployment_rank(provider_id, provider_index)
            provider_index += 1
            for model_id, model in models.items():
                if not isinstance(model_id, str) or not isinstance(model, dict):
                    continue
                entry = {
                    "id": f"{provider_id}/{model_id}",
                    "label": f"{azure_model_label(model.get('name'), model_id)} (Azure)",
                    "provider": "azure",
                    "modes": ["chat"],
                    "azureDeployment": model_id,
                    "azureBaseURL": base_url,
                    "azureApiKeyFile": api_key_file,
                    "defaultOptions": {
                        "temperature": 0.7,
                        "maxTokens": model_output_limit(model, 4096),
                    },
                }
                existing_rank = azure_rank.get(model_id)
                if existing_rank is None or rank < existing_rank:
                    azure_by_model[model_id] = entry
                    azure_rank[model_id] = rank
        elif npm == "@ai-sdk/amazon-bedrock" and provider_id == "amazon-bedrock-sigiq":
            region = clean_opencode_token(options.get("region")) or "us-east-1"
            for model_id, model in models.items():
                if not isinstance(model_id, str) or not isinstance(model, dict):
                    continue
                entry = {
                    "id": model_id,
                    "label": display_name(model.get("name"), model_id),
                    "provider": "bedrock",
                    "modes": ["chat"],
                    "bedrockRegion": region,
                    "defaultOptions": {
                        "temperature": 0.7,
                        "maxTokens": model_output_limit(model, 4096),
                    },
                }
                if model.get("reasoning"):
                    entry["effortLevels"] = ["low", "medium", "high"]
                catalog.append(entry)

    # Surface the collapsed Azure entries first (chat picker leads with Azure), then the
    # Bedrock entries gathered above, then the per-model task providers.
    catalog = list(azure_by_model.values()) + catalog
    catalog.extend(task_catalog_entries())
    return catalog


def task_catalog_entries() -> list[dict]:
    """Task-mode entries with selectable underlying models.

    Codex: the current subscription models. Claude Code: Opus / Sonnet / Haiku aliases
    resolved by the installed Claude CLI. The job runner picks the model from the
    `model` field of the submitted job; Bedrock is opt-in only when a SigiQ profile is
    explicitly configured.
    """
    codex_effort = ["low", "medium", "high", "xhigh"]
    claude_effort = ["low", "medium", "high"]
    # Real Codex models the runner exposes (matches the Codex CLI model list). Sent to the
    # job runner via `-m <taskModel>`. Codex CLI (no taskModel) uses the runner default.
    codex_models = [
        ("GPT-5.6 Sol", "gpt-5.6-sol"),
        ("GPT-5.6 Terra", "gpt-5.6-terra"),
        ("GPT-5.6 Luna", "gpt-5.6-luna"),
    ]
    entries = [
        {"id": "codex-cli", "label": "Codex CLI", "provider": "codex", "modes": ["task"], "effortLevels": codex_effort},
    ]
    entries += [
        {"id": f"codex-{tm}", "label": f"Codex · {label}", "provider": "codex", "modes": ["chat", "task"], "taskModel": tm, "effortLevels": codex_effort}
        for label, tm in codex_models
    ]
    entries += [
        {"id": "claude-code-sonnet", "label": "Claude Code · Sonnet", "provider": "claude", "modes": ["task"], "taskModel": "sonnet", "effortLevels": claude_effort},
        {"id": "claude-code-opus", "label": "Claude Code · Opus", "provider": "claude", "modes": ["task"], "taskModel": "opus", "effortLevels": claude_effort},
        {"id": "claude-code-haiku", "label": "Claude Code · Haiku", "provider": "claude", "modes": ["task"], "taskModel": "haiku", "effortLevels": claude_effort},
        {"id": "cursor-agent-auto", "label": "Cursor Agent · Auto", "provider": "cursor", "modes": ["task"], "taskModel": "auto", "effortLevels": []},
    ]
    # Curated subset of `cursor-agent --list-models`; verified live on-box
    # 2026-08-09 (--model passthrough smoke-tested as codex-runner). Re-verify
    # against the installed CLI before extending.
    cursor_models = [
        ("cursor-agent-composer-2.5", "Composer 2.5", "composer-2.5"),
        ("cursor-agent-gpt-5.3-codex", "Codex 5.3", "gpt-5.3-codex"),
        ("cursor-agent-gpt-5.6-sol-high", "GPT-5.6 Sol High", "gpt-5.6-sol-high"),
        ("cursor-agent-gpt-5.5-high", "GPT-5.5 High", "gpt-5.5-high"),
        ("cursor-agent-gpt-5.2", "GPT-5.2", "gpt-5.2"),
        ("cursor-agent-sonnet-5-thinking", "Sonnet 5 Thinking", "claude-sonnet-5-thinking-high"),
        ("cursor-agent-opus-5-thinking", "Opus 5 Thinking", "claude-opus-5-thinking-high"),
        ("cursor-agent-opus-4.8-thinking", "Opus 4.8 Thinking", "claude-opus-4-8-thinking-high"),
        ("cursor-agent-fable-5-thinking", "Fable 5 Thinking (No ZDR)", "claude-fable-5-thinking-high"),
        ("cursor-agent-grok-4.5", "Grok 4.5", "cursor-grok-4.5-high"),
        ("cursor-agent-kimi-k3", "Kimi K3", "kimi-k3-high"),
    ]
    entries += [
        {"id": mid, "label": f"Cursor Agent · {label}", "provider": "cursor", "modes": ["task"], "taskModel": tm, "effortLevels": []}
        for mid, label, tm in cursor_models
    ]
    return entries


def azure_model_label(name: object, fallback: str) -> str:
    """Base label for an Azure model, dropping any trailing '(...)' alias the OpenCode
    name embeds so we don't render double parens once '(Azure)' is appended
    (e.g. 'o1-mini (o4-mini)' -> 'o1-mini')."""
    base = display_name(name, fallback)
    return re.sub(r"\s*\([^()]*\)\s*$", "", base).strip() or fallback


def azure_deployment_rank(provider_id: str, config_index: int) -> tuple[int, int]:
    """Priority for choosing which deployment wins a duplicated model id.

    Lower sorts first. A 'prod' deployment beats a neutral one, which beats 'dev';
    ties fall back to the order the provider appears in opencode.jsonc.
    """
    name = provider_id.lower()
    if "prod" in name:
        tier = 0
    elif "dev" in name:
        tier = 2
    else:
        tier = 1
    return (tier, config_index)


def strip_jsonc(text: str) -> str:
    result: list[str] = []
    in_string = False
    escape = False
    i = 0
    while i < len(text):
        ch = text[i]
        nxt = text[i + 1] if i + 1 < len(text) else ""
        if in_string:
            result.append(ch)
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == '"':
                in_string = False
            i += 1
            continue
        if ch == '"':
            in_string = True
            result.append(ch)
            i += 1
            continue
        if ch == "/" and nxt == "/":
            i = text.find("\n", i)
            if i == -1:
                break
            result.append("\n")
            i += 1
            continue
        if ch == "/" and nxt == "*":
            end = text.find("*/", i + 2)
            if end == -1:
                break
            result.append("\n" * text[i:end + 2].count("\n"))
            i = end + 2
            continue
        result.append(ch)
        i += 1
    return "".join(result)


def display_name(value: object, fallback: str) -> str:
    text = value.strip() if isinstance(value, str) else ""
    return text or fallback


def clean_opencode_token(value: object) -> str:
    if not isinstance(value, str):
        return ""
    return value.strip()


def clean_opencode_url(value: object) -> str:
    text = clean_opencode_token(value).rstrip("/")
    parsed = urlparse(text)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        return ""
    return text


def file_ref_path(value: object) -> str:
    text = clean_opencode_token(value)
    match = re.fullmatch(r"\{file:(.+)\}", text)
    if not match:
        return ""
    return str(Path(match.group(1)).expanduser())


def model_output_limit(model: dict, fallback: int) -> int:
    limit = model.get("limit")
    output = limit.get("output") if isinstance(limit, dict) else None
    return output if isinstance(output, int) and 0 < output <= 200000 else fallback


