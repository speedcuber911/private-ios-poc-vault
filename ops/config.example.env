# Copy to ~/.poc-vault/secrets/config.env and fill in local values.
# You can also generate a starter file with:
#   ops/init-install-config --domain-root example.com
AWS_REGION=ap-south-1
DOMAIN_ROOT=example.com
VAULT_DOMAIN=vault.pocs.example.com
POC_WILDCARD_DOMAIN=*.pocs.example.com
POC_DOMAIN_SUFFIX=pocs.example.com
CODEX_DOMAIN=codex.pocs.example.com
POC_VAULT_MANIFEST_URL=https://vault.pocs.example.com/manifest.json
POC_VAULT_SIGNATURE_URL=https://vault.pocs.example.com/manifest.sig.json
POC_VAULT_CODEX_BASE_URL=https://codex.pocs.example.com
# Raw Ed25519 manifest public key, base64url. Generate from the local signing key:
#   ops/manifest-public-key
POC_VAULT_MANIFEST_PUBLIC_KEY=
HOSTED_ZONE_ID=
INSTANCE_NAME=poc-vault
INSTANCE_TYPE=t3.micro
KEY_NAME=poc-vault
KEY_PATH=$HOME/.poc-vault/secrets/ssh/poc-vault.pem
SSH_PUBLIC_KEY_PATH=$HOME/.poc-vault/secrets/ssh/poc-vault.pem.pub
ADMIN_CIDR=
SECURITY_GROUP_NAME=poc-vault-nginx-mtls
ALLOCATE_EIP=true
ENABLE_HTTP=false
DEPLOY_USER=deploy
DEPLOY_HOST=
SERVER_ROOT=/srv/poc-vault
LOCAL_SECRETS_DIR=$HOME/.poc-vault/secrets
TLS_DIR=/etc/poc-vault/tls
NGINX_CONF_PATH=/etc/nginx/conf.d/poc-vault.conf
CLIENT_CERT_DAYS=90
CLIENT_CA_DAYS=3650
# Required when exporting client .p12 packages. Keep real values only in local config.
CLIENT_P12_PASSWORD=
# Also accepted for the iPhone client provisioning flow.
IPHONE_P12_PASSWORD=
BUNDLE_ID=com.parikshit.pocvault
IOS_BUNDLE_ID=com.parikshit.pocvault
DEVELOPMENT_TEAM=
LE_EMAIL=

# Codex API install values. Keep real secrets only in local config or /etc/codex-api.env.
CODEX_API_INSTALL_DIR=/opt/codex-api
CODEX_API_ENV_PATH=/etc/codex-api.env
CODEX_API_NGINX_CONF_PATH=/etc/nginx/conf.d/codex-api.conf
CODEX_MTLS_DIR=/etc/codex-api/mtls
CODEX_ALLOWED_CERT_SUBJECTS=CN=iphone,CN=parikshit-mac
CODEX_WORKSPACES='[{"id":"scratch","name":"Scratch","path":"/srv/codex-workspaces/scratch"},{"id":"poc-vault","name":"POC Vault","path":"/srv/codex-workspaces/poc-vault"},{"id":"sigiq","name":"SigiQ","path":"/srv/codex-workspaces/sigiq"}]'
CLAUDE_AWS_PROFILE=
CLAUDE_DEFAULT_MODEL=sonnet
CLAUDE_SONNET_MODEL=sonnet
CLAUDE_OPUS_MODEL=opus
CLAUDE_HAIKU_MODEL=haiku
BEDROCK_CHAT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1
# If present, ops/render-codex-api-config derives CODEX_MODEL_CATALOG from this
# OpenCode config so Relay exposes the same local Azure/Bedrock model inventory.
OPENCODE_CONFIG_PATH=~/.config/opencode/opencode.jsonc
CODEX_MODEL_CATALOG='[{"id":"codex-gpt-5.6-sol","label":"Codex · GPT-5.6 Sol","provider":"codex","modes":["chat","task"],"taskModel":"gpt-5.6-sol","effortLevels":["low","medium","high","xhigh"]},{"id":"codex-gpt-5.6-terra","label":"Codex · GPT-5.6 Terra","provider":"codex","modes":["chat","task"],"taskModel":"gpt-5.6-terra","effortLevels":["low","medium","high","xhigh"]},{"id":"codex-gpt-5.6-luna","label":"Codex · GPT-5.6 Luna","provider":"codex","modes":["chat","task"],"taskModel":"gpt-5.6-luna","effortLevels":["low","medium","high","xhigh"]},{"id":"cursor-agent-auto","label":"Cursor Agent · Auto","provider":"cursor","modes":["task"],"taskModel":"auto","effortLevels":[]},{"id":"claude-code-sonnet","label":"Claude Code · Sonnet","provider":"claude","modes":["task"],"taskModel":"sonnet","effortLevels":["low","medium","high"]},{"id":"claude-code-opus","label":"Claude Code · Opus","provider":"claude","modes":["task"],"taskModel":"opus","effortLevels":["low","medium","high"]},{"id":"claude-code-haiku","label":"Claude Code · Haiku","provider":"claude","modes":["task"],"taskModel":"haiku","effortLevels":["low","medium","high"]}]'
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
CODEX_MAX_BODY_BYTES=31457280
CODEX_MAX_JOB_ATTACHMENTS=6
CODEX_MAX_JOB_ATTACHMENT_BYTES=8388608
CODEX_MAX_JOB_ATTACHMENT_TOTAL_BYTES=18874368
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_API_VERSION=2025-10-15
AZURE_SPEECH_TRANSCRIPTION_MODEL=mai-transcribe-1
AZURE_SPEECH_LOCALES=en
