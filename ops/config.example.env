# Copy to ~/.poc-vault/secrets/config.env and fill in local values.
# You can also generate a starter file with:
#   ops/init-install-config --domain-root example.com
AWS_REGION=ap-south-1
DOMAIN_ROOT=example.com
VAULT_DOMAIN=vault.pocs.example.com
POC_WILDCARD_DOMAIN=*.pocs.example.com
POC_DOMAIN_SUFFIX=pocs.example.com
CODEX_DOMAIN=codex.pocs.example.com
POC_VAULT_MANIFEST_URL=https://vault.pocs.example.com/manifest.json
POC_VAULT_SIGNATURE_URL=https://vault.pocs.example.com/manifest.sig.json
POC_VAULT_CODEX_BASE_URL=https://codex.pocs.example.com
# Raw Ed25519 manifest public key, base64url. Generate from the local signing key:
#   ops/manifest-public-key
POC_VAULT_MANIFEST_PUBLIC_KEY=
HOSTED_ZONE_ID=
INSTANCE_NAME=poc-vault
INSTANCE_TYPE=t3.micro
KEY_NAME=poc-vault
KEY_PATH=$HOME/.poc-vault/secrets/ssh/poc-vault.pem
SSH_PUBLIC_KEY_PATH=$HOME/.poc-vault/secrets/ssh/poc-vault.pem.pub
ADMIN_CIDR=
SECURITY_GROUP_NAME=poc-vault-nginx-mtls
ALLOCATE_EIP=true
ENABLE_HTTP=false
DEPLOY_USER=deploy
DEPLOY_HOST=
SERVER_ROOT=/srv/poc-vault
LOCAL_SECRETS_DIR=$HOME/.poc-vault/secrets
TLS_DIR=/etc/poc-vault/tls
NGINX_CONF_PATH=/etc/nginx/conf.d/poc-vault.conf
CLIENT_CERT_DAYS=90
CLIENT_CA_DAYS=3650
# Required when exporting client .p12 packages. Keep real values only in local config.
CLIENT_P12_PASSWORD=
# Also accepted for the iPhone client provisioning flow.
IPHONE_P12_PASSWORD=
BUNDLE_ID=com.example.pocvault
IOS_BUNDLE_ID=com.example.pocvault
DEVELOPMENT_TEAM=
LE_EMAIL=

# Codex API install values. Keep real secrets only in local config or /etc/codex-api.env.
CODEX_API_INSTALL_DIR=/opt/codex-api
CODEX_API_ENV_PATH=/etc/codex-api.env
CODEX_API_NGINX_CONF_PATH=/etc/nginx/conf.d/codex-api.conf
CODEX_MTLS_DIR=/etc/codex-api/mtls
CODEX_ALLOWED_CERT_SUBJECTS=CN=iphone,CN=operator
CODEX_WORKSPACES='[{"id":"scratch","name":"Scratch","path":"/srv/codex-workspaces/scratch"},{"id":"poc-vault","name":"POC Vault","path":"/srv/codex-workspaces/poc-vault"}]'
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_API_VERSION=2025-10-15
AZURE_SPEECH_TRANSCRIPTION_MODEL=mai-transcribe-1
AZURE_SPEECH_LOCALES=en
