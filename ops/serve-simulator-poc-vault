def _sim_sync_worktree_descriptor(server: SimulatorVaultServer, repo_path: str) -> None:
    repo = server.sim_git_repos.get(repo_path)
    if repo is None:
        return
    dirty, added, deleted = _sim_repo_stats(repo)
    head = repo["commits"][0]["sha"] if repo["commits"] else "0" * 40
    for entries in server.sim_worktrees.values():
        for wt in entries:
            if wt["path"] == repo_path:
                wt["branch"] = repo["branch"]
                wt["head"] = head
                wt["dirty"] = dirty
                wt["added"] = added
                wt["deleted"] = deleted


def _sim_resolve_git_repo_unlocked(server: SimulatorVaultServer, raw_path: str | None) -> tuple[str | None, dict | None]:
    norm = _sim_norm_path(raw_path)
    if not norm:
        return (_SIM_DEFAULT_WORKTREE_PATH, server.sim_git_repos.get(_SIM_DEFAULT_WORKTREE_PATH))
    if not norm.startswith("/"):
        norm = f"{_SIM_WORKSPACE_ROOT}/{norm.lstrip('/')}"
    if norm == f"{_SIM_WORKSPACE_ROOT}/scratch" or norm.startswith(f"{_SIM_WORKSPACE_ROOT}/scratch/"):
        return (None, None)
    # Longest-prefix match so worktrees inside <repo>/.relay/worktrees/<slug> win over <repo>.
    for candidate in sorted(server.sim_git_repos.keys(), key=len, reverse=True):
        if norm == candidate or norm.startswith(candidate + "/"):
            return (candidate, server.sim_git_repos[candidate])
    return (None, None)


def _sim_resolve_project_root_unlocked(server: SimulatorVaultServer, raw_path: str | None) -> str | None:
    norm = _sim_norm_path(raw_path)
    if not norm:
        return _SIM_POC_VAULT_MAIN_PATH
    if not norm.startswith("/"):
        norm = f"{_SIM_WORKSPACE_ROOT}/{norm.lstrip('/')}"
    for project_root, entries in server.sim_worktrees.items():
        if norm == project_root or norm.startswith(project_root + "/"):
            return project_root
        for wt in entries:
            if norm == wt["path"] or norm.startswith(wt["path"] + "/"):
                return project_root
    return None


