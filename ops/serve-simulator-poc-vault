def _sim_task_entries() -> list[dict]:
    """Task-mode entries with selectable underlying models (mirrors render-codex-api-config)."""
    codex_effort = ["low", "medium", "high", "xhigh"]
    claude_effort = ["low", "medium", "high"]
    codex_models = [
        ("GPT-5.5", "gpt-5.5"),
        ("GPT-5.4", "gpt-5.4"),
        ("GPT-5.4-Mini", "gpt-5.4-mini"),
        ("GPT-5.3-Codex-Spark", "gpt-5.3-codex-spark"),
    ]
    entries = [{"id": "codex-cli", "label": "Codex CLI", "provider": "codex", "modes": ["task"], "effortLevels": codex_effort}]
    entries += [
        {"id": f"codex-{tm}", "label": f"Codex · {label}", "provider": "codex", "modes": ["task"], "taskModel": tm, "effortLevels": codex_effort}
        for label, tm in codex_models
    ]
    entries += [
        {"id": "claude-code-sonnet", "label": "Claude Code · Sonnet", "provider": "claude", "modes": ["task"], "taskModel": "sonnet", "effortLevels": claude_effort},
        {"id": "claude-code-opus", "label": "Claude Code · Opus", "provider": "claude", "modes": ["task"], "taskModel": "opus", "effortLevels": claude_effort},
        {"id": "claude-code-haiku", "label": "Claude Code · Haiku", "provider": "claude", "modes": ["task"], "taskModel": "haiku", "effortLevels": claude_effort},
    ]
    return entries


def opencode_fixture_models() -> list[dict]:
    config_path = Path(os.environ.get("OPENCODE_CONFIG_PATH", "~/.config/opencode/opencode.jsonc")).expanduser()
    if not config_path.is_file():
        return []
    try:
        config = json.loads(strip_jsonc(config_path.read_text(encoding="utf-8")))
    except (OSError, json.JSONDecodeError):
        return []
    providers = config.get("provider", {})
    if not isinstance(providers, dict):
        return []

    models: list[dict] = []
    # Mirror ops/render-codex-api-config: collapse the Azure deployment cross-product so
    # the picker shows one "<model> (Azure)" row per model id instead of one per endpoint.
    azure_by_model: dict[str, dict] = {}
    azure_rank: dict[str, tuple[int, int]] = {}
    provider_index = 0
    for provider_id, provider in providers.items():
        if not isinstance(provider_id, str) or not isinstance(provider, dict):
            continue
        npm = provider.get("npm")
        options = provider.get("options", {}) if isinstance(provider.get("options"), dict) else {}
        provider_models = provider.get("models", {}) if isinstance(provider.get("models"), dict) else {}
        if npm == "@ai-sdk/openai-compatible" and options.get("baseURL"):
            rank = azure_deployment_rank(provider_id, provider_index)
            provider_index += 1
            for model_id, model in provider_models.items():
                if not isinstance(model_id, str) or not isinstance(model, dict):
                    continue
                entry = {
                    "id": f"{provider_id}/{model_id}",
                    "label": f"{azure_model_label(model.get('name'), model_id)} (Azure)",
                    "provider": "azure",
                    "modes": ["chat"],
                    "azureDeployment": model_id,
                    "defaultOptions": {"temperature": 0.7, "maxTokens": model_output_limit(model, 4096)},
                }
                existing_rank = azure_rank.get(model_id)
                if existing_rank is None or rank < existing_rank:
                    azure_by_model[model_id] = entry
                    azure_rank[model_id] = rank
        elif npm == "@ai-sdk/amazon-bedrock" and provider_id == "amazon-bedrock-sigiq":
            for model_id, model in provider_models.items():
                if not isinstance(model_id, str) or not isinstance(model, dict):
                    continue
                entry = {
                    "id": model_id,
                    "label": display_name(model.get("name"), model_id),
                    "provider": "bedrock",
                    "modes": ["chat"],
                    "defaultOptions": {"temperature": 0.7, "maxTokens": model_output_limit(model, 4096)},
                }
                if model.get("reasoning"):
                    entry["effortLevels"] = ["low", "medium", "high"]
                models.append(entry)

    models = list(azure_by_model.values()) + models
    models.extend(_sim_task_entries())
    return models


def public_catalog(models: object) -> list[dict]:
    if not isinstance(models, list):
        return []
    private_keys = {"azureApiKeyFile", "azureApiKeyEnv", "azureBaseURL", "bedrockRegion"}
    return [
        {key: value for key, value in model.items() if key not in private_keys}
        for model in models
        if isinstance(model, dict)
    ]


def strip_jsonc(text: str) -> str:
    result: list[str] = []
    in_string = False
    escape = False
    i = 0
    while i < len(text):
        ch = text[i]
        nxt = text[i + 1] if i + 1 < len(text) else ""
        if in_string:
            result.append(ch)
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == '"':
                in_string = False
            i += 1
            continue
        if ch == '"':
            in_string = True
            result.append(ch)
            i += 1
            continue
        if ch == "/" and nxt == "/":
            i = text.find("\n", i)
            if i == -1:
                break
            result.append("\n")
            i += 1
            continue
        if ch == "/" and nxt == "*":
            end = text.find("*/", i + 2)
            if end == -1:
                break
            result.append("\n" * text[i:end + 2].count("\n"))
            i = end + 2
            continue
        result.append(ch)
        i += 1
    return "".join(result)


def display_name(value: object, fallback: str) -> str:
    return value.strip() if isinstance(value, str) and value.strip() else fallback


def azure_model_label(name: object, fallback: str) -> str:
    base = display_name(name, fallback)
    return re.sub(r"\s*\([^()]*\)\s*$", "", base).strip() or fallback


def azure_deployment_rank(provider_id: str, config_index: int) -> tuple[int, int]:
    name = provider_id.lower()
    tier = 0 if "prod" in name else 2 if "dev" in name else 1
    return (tier, config_index)


def model_output_limit(model: dict, fallback: int) -> int:
    limit = model.get("limit")
    output = limit.get("output") if isinstance(limit, dict) else None
    return output if isinstance(output, int) and 0 < output <= 200000 else fallback


