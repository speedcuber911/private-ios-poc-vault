def _sim_default_branches(current_branch: str) -> list[dict]:
    local_specs = [
        ("main", "origin/main"),
        ("fix-138-number-keys", "origin/fix-138-number-keys"),
        ("feat/paseo-ui", "origin/feat/paseo-ui"),
        ("chore/ansi-256-colors", None),
    ]
    branches: list[dict] = []
    seen_local: set[str] = set()
    for name, upstream in local_specs:
        seen_local.add(name)
        branches.append({
            "name": name,
            "isCurrent": name == current_branch,
            "isRemote": False,
            "upstream": upstream,
        })
    if current_branch and current_branch not in seen_local:
        branches.append({
            "name": current_branch,
            "isCurrent": True,
            "isRemote": False,
            "upstream": None,
        })
    branches.sort(key=lambda item: (0 if item["isCurrent"] else 1, item["name"]))
    for remote_name in ("origin/main", "origin/fix-138-number-keys", "origin/feat/paseo-ui"):
        branches.append({
            "name": remote_name,
            "isCurrent": False,
            "isRemote": True,
            "upstream": None,
        })
    return branches


