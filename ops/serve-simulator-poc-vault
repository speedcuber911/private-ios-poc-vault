_SIM_WORKSPACES = [
    {"id": "scratch", "name": "Scratch", "path": f"{_SIM_WORKSPACE_ROOT}/scratch", "summary": "Throwaway sandbox", "isDefault": False},
    {"id": "poc-vault", "name": "POC Vault", "path": f"{_SIM_WORKSPACE_ROOT}/poc-vault", "summary": "POC hosting repo", "isDefault": True},
    {"id": "sigiq", "name": "SigiQ", "path": f"{_SIM_WORKSPACE_ROOT}/sigiq", "summary": "SigiQ monorepo", "isDefault": False},
]
# Child directories surfaced when browsing into a workspace (keyed by workspace path).
_SIM_WORKSPACE_CHILDREN = {
    f"{_SIM_WORKSPACE_ROOT}/sigiq": [
        {"name": "ai-tutor", "hasGit": True},
        {"name": "leap-workbench", "hasGit": True},
        {"name": "data-readiness", "hasGit": False},
    ],
    f"{_SIM_WORKSPACE_ROOT}/poc-vault": [
        {"name": "pocs", "hasGit": False},
        {"name": "ops", "hasGit": False},
    ],
}


def codex_fixture_workspaces() -> list[dict]:
    return [dict(ws) for ws in _SIM_WORKSPACES]


def codex_fixture_workspace_dirs(path: str) -> dict:
    current = path.strip() or _SIM_WORKSPACE_ROOT
    registered = {ws["path"]: ws for ws in _SIM_WORKSPACES}
    if current == _SIM_WORKSPACE_ROOT:
        # Root lists the registered workspaces as browsable folders.
        entries = [
            {
                "name": ws["name"],
                "path": ws["path"],
                "relativePath": ws["id"],
                "workspaceId": ws["id"],
                "workspaceName": ws["name"],
                "hasGit": True,
                "isRegistered": True,
            }
            for ws in _SIM_WORKSPACES
        ]
        parent = None
        relative = ""
    else:
        children = _SIM_WORKSPACE_CHILDREN.get(current, [])
        entries = [
            {
                "name": child["name"],
                "path": f"{current}/{child['name']}",
                "relativePath": f"{current[len(_SIM_WORKSPACE_ROOT) + 1:]}/{child['name']}",
                "workspaceId": None,
                "workspaceName": None,
                "hasGit": child["hasGit"],
                "isRegistered": False,
            }
            for child in children
        ]
        parent = _SIM_WORKSPACE_ROOT
        relative = current[len(_SIM_WORKSPACE_ROOT) + 1:]
    return {
        "rootPath": _SIM_WORKSPACE_ROOT,
        "currentPath": current,
        "relativePath": relative,
        "parentPath": parent,
        "selectedWorkspace": registered.get(current),
        "entries": entries,
    }


