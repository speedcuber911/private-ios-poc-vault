        # after the last message arrive as `trailingSteps`.
        history = sim_history_steps()
        detail["messages"][1]["steps"] = history[:2]
        detail["messages"][2]["steps"] = history[2:6]
        detail["trailingSteps"] = history[6:]
        detail["jobs"][0]["timelineEvents"] = len(sim_timeline_script())
    return detail


