            disk_read = 11_000 + 3_400 * abs(math.sin(index / 7.0))
            disk_write = 7_200 + 1_800 * abs(math.cos(index / 5.0))
        cpu = round(16.4 + wave + cpu_spike, 1)
        memory = round(40.8 + 0.7 * math.sin(index / 9.0), 1)
