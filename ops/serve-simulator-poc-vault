#!/usr/bin/env python3
"""Serve a local signed POC Vault manifest and static POCs for iOS Simulator."""

from __future__ import annotations

import argparse
import json
import mimetypes
import os
import re
import subprocess
import sys
import threading
import time
import math
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlparse


ROOT = Path(__file__).resolve().parents[1]
SLUG_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$")
_SIM_PREVIEW_TOKEN = "s" * 43
_SIM_LIVE_PREVIEW = (ROOT / "ops" / "fixtures" / "launch-checklist.html").read_bytes()


class SimJob:
    """One submitted job: who asked for what, and its scripted timeline. The
    timeline advances on its own thread, like a real job, so a stream can drop
    and re-attach with `timeline=<n>` without restarting the run."""

    def __init__(self, id: str):
        self.id = id
        self.provider = "codex"
        self.model: str | None = None
        self.prompt = "Inspect the workspace."
        self.tick = 0
        self.created_at = "2026-05-23T13:34:00Z"
        self.started_at = "2026-05-23T13:34:02Z"
        self.completed_at: str | None = None
        self.timeline: list[dict] = []
        # The prose of the timeline as a stdout log, the way relayd keeps one:
        # what SIM_TIMELINE_STDOUT=1 streams, from a byte offset.
        self.stdout = bytearray()
        self.timeline_enabled = False
        self.timeline_done = True
        self.final_status = "succeeded"
        self.generation = 0
        # SIM_TIMELINE_APPROVAL=1: the run parks at its first command.
        self.waiting_for_approval = False
        self.approval: dict | None = None


class SimulatorVaultServer(ThreadingHTTPServer):
    def __init__(self, server_address: tuple[str, int], handler_class: type[BaseHTTPRequestHandler]):
        super().__init__(server_address, handler_class)
        self.manifest_dir = ROOT / "build" / "simulator"
        self.pocs_dir = ROOT / "pocs"
        self.approval_pending = True
        self.approval_resolution: dict | None = None
        self.terminals: dict[str, dict] = {}
        self.dynamic_workspaces: dict[str, dict] = {}
        self.terminal_counter = 0
        # Every submitted job gets its own id (`sim-job-<n>`) and its own state,
        # like a real machine. `sim-job-running` stays as an alias for the
        # latest one, for hooks and scripts that predate per-job ids.
        self.sim_jobs: dict[str, SimJob] = {}
        self.sim_job_counter = 0
        self.active_job = SimJob("sim-job-running")
        self.handoff_job_id: str | None = None
        self.fixture_lock = threading.Lock()


class Handler(BaseHTTPRequestHandler):
    server: SimulatorVaultServer

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        path = unquote(parsed.path)
        query = parsed.query

        if path == "/healthz":
            self.send_bytes(b"ok\n", "text/plain")
            return
        if path == "/api/auth/get-session":
            self.send_json({"user": simulator_account_user()})
            return
        if path == "/v1/auth/device/link":
            self.send_json({"computer": simulator_computer_link()})
            return
        if path == "/v1/handoffs":
            self.send_json({"handoffs": [simulator_handoff(self.server.handoff_job_id)]})
            return
        if path == "/v1/handoffs/sim-handoff-4f89a2c1":
            handoff = simulator_handoff(self.server.handoff_job_id)
            handoff["manifest"] = simulator_handoff_manifest()
            self.send_json({"handoff": handoff})
            return
        if path == "/v1/mac-sessions":
            self.send_json({"index": simulator_mac_session_index()})
            return
        if path == "/v1/harness":
            self.send_json({"harnesses": simulator_harnesses()})
            return
        if path == "/v1/machine/stats":
            self.send_json(simulator_machine_stats())
            return
        if path.startswith("/v1/codex/"):
            self.serve_codex_fixture(path, query)
            return
        if path == "/manifest.json":
            self.send_file(self.server.manifest_dir / "manifest.json", "application/json")
            return
        if path == "/manifest.sig.json":
            self.send_file(self.server.manifest_dir / "manifest.sig.json", "application/json")
            return
        if path.startswith("/pocs/"):
            self.serve_poc(path)
            return

        self.send_error(404)

    def do_POST(self) -> None:
        parsed = urlparse(self.path)
        path = unquote(parsed.path)
        if path in {"/api/auth/sign-up/email", "/api/auth/sign-in/username"}:
            self.read_json_body()
            self.send_json({"token": "relay-simulator-session", "user": simulator_account_user()})
            return
        if path == "/api/auth/sign-out":
            self.send_json({})
            return
        if path == "/api/auth/delete-user":
            self.send_json({"success": True, "message": "Simulator account deleted."})
            return
        if path == "/v1/handoffs/sim-handoff-4f89a2c1/continue":
            with self.server.fixture_lock:
                self.server.handoff_job_id = "sim-job-handoff"
            self.send_response(202)
            payload = json.dumps({
                "id": "sim-job-handoff",
                "job": codex_fixture_handoff_job(),
            }).encode("utf-8")
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return
        if path == "/v1/codex/chat":
            self.serve_codex_chat_fixture()
            return
        if path == "/v1/codex/jobs":
            body = self.read_json_body()
            provider = str(body.get("provider") or "codex")
            if provider not in {"codex", "claude", "cursor", "kimi"}:
                provider = "codex"
            model = body.get("model")
            prompt = body.get("prompt")
            with self.server.fixture_lock:
                self.server.sim_job_counter += 1
                job = SimJob(f"sim-job-{self.server.sim_job_counter}")
                job.provider = provider
                job.model = str(model) if isinstance(model, str) and model else None
                job.prompt = str(prompt) if isinstance(prompt, str) and prompt else "Inspect the workspace."
                # Supersede the previous run: one scripted job at a time.
                self.server.active_job.generation += 1
                self.server.sim_jobs[job.id] = job
                self.server.active_job = job
            start_sim_timeline(self.server, job)
            self.send_json({
                "id": job.id,
                "job": sim_job_payload(self.server, job),
            })
            return
        if path == "/v1/codex/previews":
            body = self.read_json_body()
            if body.get("jobId") not in {"sim-job-linear", "sim-job-handoff"} and sim_job_for(self.server, str(body.get("jobId") or "")) is None:
                self.send_json_error(404, "job not found")
                return
            if not simulator_preview_source_is_valid(body.get("url")):
                self.send_json_error(400, "preview URL was not returned by this job")
                return
            self.send_json({
                "id": _SIM_PREVIEW_TOKEN,
                "url": f"/v1/codex/previews/{_SIM_PREVIEW_TOKEN}/",
                "expiresAt": (datetime.now(timezone.utc) + timedelta(minutes=30)).isoformat(timespec="seconds").replace("+00:00", "Z"),
            }, status=201)
            return
        cancel_match = re.fullmatch(r"/v1/codex/jobs/([^/]+)/cancel", path)
        if cancel_match and sim_job_for(self.server, cancel_match.group(1)) is not None:
            job = sim_job_for(self.server, cancel_match.group(1))
            with self.server.fixture_lock:
                if not job.timeline_done or not job.timeline_enabled:
                    job.generation += 1
                    job.final_status = "canceled"
                    job.timeline_done = True
                    job.waiting_for_approval = False
                    job.completed_at = sim_now_iso()
            payload = sim_job_payload(self.server, job)
            if not job.timeline_enabled:
                payload.update({"status": "canceled", "result": "Simulator job canceled.", "artifacts": []})
            self.send_json(payload)
            return
        approval_match = re.fullmatch(r"/v1/codex/approvals/([^/]+)/decision", path)
        if approval_match:
            scripted = sim_job_for_approval(self.server, approval_match.group(1))
            if approval_match.group(1) != "sim-approval-shell" and scripted is None:
                self.send_json_error(404, "approval was not found")
                return
            body = self.read_json_body()
            decision = str(body.get("decision") or "")
            if decision not in {"accept", "acceptForSession", "decline", "cancel"}:
                self.send_json_error(400, "decision is invalid")
                return
            if scripted is not None:
                with self.server.fixture_lock:
                    scripted.approval["status"] = "resolved"
                    scripted.approval["resolution"] = {
                        "decision": decision,
                        "decidedAt": sim_now_iso(),
                        "message": body.get("message"),
                    }
                    scripted.waiting_for_approval = False
                self.send_json({"approval": dict(scripted.approval)})
                return
            with self.server.fixture_lock:
                self.server.approval_pending = False
                self.server.approval_resolution = {
                    "decision": decision,
                    "decidedAt": "2026-08-14T11:00:30Z",
                    "message": body.get("message"),
                }
            self.send_json({"approval": codex_fixture_approval(self.server)})
            return
        if path == "/v1/codex/terminals":
            body = self.read_json_body()
            workspace_id = str(body.get("workspaceId") or "")
            workspace = next((item for item in _SIM_WORKSPACES if item["id"] == workspace_id), None)
            workspace = workspace or self.server.dynamic_workspaces.get(workspace_id)
            if workspace is None:
                self.send_json_error(400, "unknown workspaceId")
                return
            with self.server.fixture_lock:
                self.server.terminal_counter += 1
                terminal_id = f"sim-terminal-{self.server.terminal_counter}"
                terminal = codex_fixture_terminal(
                    terminal_id,
                    workspace,
                    cols=bounded_int(body.get("cols"), 80, 20, 240),
                    rows=bounded_int(body.get("rows"), 24, 8, 100),
                )
                self.server.terminals[terminal_id] = {
                    "terminal": terminal,
                    "output": f"Relay terminal · {workspace['name']}\n$ ",
                    "version": 0,
                }
            self.send_json({"terminal": terminal})
            return
        terminal_input_match = re.fullmatch(r"/v1/codex/terminals/([^/]+)/input", path)
        if terminal_input_match:
            body = self.read_json_body()
            text = str(body.get("text") or "")
            record = self.server.terminals.get(terminal_input_match.group(1))
            if record is None:
                self.send_json_error(404, "terminal was not found")
                return
            with self.server.fixture_lock:
                command = text.strip()
                record["output"] += text
                if command == "pwd":
                    workspace_id = record["terminal"]["workspaceId"]
                    workspace = next((item for item in _SIM_WORKSPACES if item["id"] == workspace_id), None)
                    workspace = workspace or self.server.dynamic_workspaces[workspace_id]
                    record["output"] += f"{workspace['path']}\n$ "
                elif command in {"exit", "logout"}:
                    record["output"] += "logout\n"
                    record["terminal"].update({
                        "status": "exited",
                        "updatedAt": "2026-08-14T11:01:00Z",
                        "finishedAt": "2026-08-14T11:01:00Z",
                        "exitCode": 0,
                    })
                elif command:
                    record["output"] += f"simulator: {command}\n$ "
                record["version"] += 1
            self.send_json({"terminal": record["terminal"]})
            return
        terminal_close_match = re.fullmatch(r"/v1/codex/terminals/([^/]+)/close", path)
        if terminal_close_match:
            record = self.server.terminals.get(terminal_close_match.group(1))
            if record is None:
                self.send_json_error(404, "terminal was not found")
                return
            with self.server.fixture_lock:
                record["terminal"].update({
                    "status": "closed",
                    "updatedAt": "2026-08-14T11:01:00Z",
                    "finishedAt": "2026-08-14T11:01:00Z",
                    "exitCode": record["terminal"].get("exitCode"),
                })
                record["version"] += 1
            self.send_json({"terminal": record["terminal"]})
            return
        if path == "/v1/codex/transcriptions":
            self.send_json({"text": "Simulator voice transcript", "durationMs": 1200})
            return
        if path == "/v1/codex/workspaces/select":
            body = self.read_json_body()
            listing = codex_fixture_fs_list(str(body.get("path") or ""), {})
            workspace = listing.get("workspace") if listing else None
            if workspace is None:
                self.send_json_error(400, "workspace root cannot be selected")
                return
            with self.server.fixture_lock:
                self.server.dynamic_workspaces[workspace["id"]] = workspace
            self.send_json(workspace)
            return
        if path == "/v1/codex/workspaces/create":
            self.send_json(codex_fixture_workspace(id="sim-new-workspace", name="New Workspace", path="/srv/codex-workspaces/new-workspace"))
            return
        self.send_error(404)

    def do_DELETE(self) -> None:
        path = unquote(urlparse(self.path).path)
        if path == "/v1/auth/device/link":
            self.send_json({"ok": True})
            return
        self.send_error(404)

    def serve_codex_fixture(self, path: str, query: str) -> None:
        if path == "/v1/codex/health":
            self.send_json({"ok": True, "status": "ok", "message": "Simulator Codex fixture"})
            return
        if path == "/v1/codex/models":
            self.send_json({"models": codex_fixture_models()})
            return
        if path == f"/v1/codex/previews/{_SIM_PREVIEW_TOKEN}/":
            self.send_bytes(_SIM_LIVE_PREVIEW, "text/html; charset=utf-8")
            return
        if path == "/v1/codex/skills":
            provider = parse_qs(query).get("provider", ["codex"])[0]
            if provider not in {"codex", "claude", "cursor", "kimi"}:
                self.send_json_error(400, "provider is invalid")
                return
            self.send_json({"provider": provider, "skills": codex_fixture_skills(provider)})
            return
        if path == "/v1/codex/approvals":
            params = parse_qs(query)
            approval = codex_fixture_approval(self.server)
            approvals = [approval]
            with self.server.fixture_lock:
                approvals += [dict(job.approval) for job in self.server.sim_jobs.values() if job.approval]
            job_id = params.get("jobId", [""])[0]
            status = params.get("status", [""])[0]
            if job_id:
                approvals = [item for item in approvals if item["jobId"] == job_id]
            if status:
                approvals = [item for item in approvals if item["status"] == status]
            self.send_json({"approvals": approvals})
            return
        if path == "/v1/codex/workspaces":
            self.send_json({"workspaces": codex_fixture_workspaces()})
            return
        if path == "/v1/codex/workspace-dirs":
            self.send_json(codex_fixture_workspace_dirs(parse_qs(query).get("path", [""])[0]))
            return
        if path == "/v1/codex/fs/list":
            self.serve_codex_fs_list(parse_qs(query))
            return
        if path == "/v1/codex/fs/file":
            self.serve_codex_fs_file(parse_qs(query))
            return
        if path == "/v1/codex/jobs":
            jobs = [codex_fixture_approval_job(self.server), codex_fixture_job()]
            if self.server.handoff_job_id:
                jobs.append(codex_fixture_handoff_job())
            self.send_json({"jobs": jobs})
            return
        if path == "/v1/codex/sessions":
            sessions = [codex_fixture_session()]
            if self.server.handoff_job_id:
                sessions.append({**codex_fixture_session(), "id": "sim-claude-handoff-thread", "provider": "claude"})
            self.send_json({"sessions": sessions})
            return
        if path == "/v1/codex/threads":
            workspace_id = parse_qs(query).get("workspaceId", [""])[0]
            threads = [codex_fixture_thread(), codex_fixture_chat_thread(), codex_fixture_scoped_chat_thread()]
            if self.server.handoff_job_id:
                threads.append(codex_fixture_handoff_thread())
            if workspace_id:
                # Workspace filters merge task and chat threads for that folder;
                # legacy null-workspace chats stay global-only.
                threads = [t for t in threads if t.get("workspaceId") == workspace_id]
            threads.sort(key=lambda t: t.get("updatedAt") or "", reverse=True)
            self.send_json({"threads": threads})
            return
        if path == "/v1/codex/threads/sim-thread-linear":
            self.send_json(codex_fixture_thread_detail())
            return
        if path == "/v1/codex/jobs/sim-job-linear/timeline" and sim_history_steps_enabled():
            self.send_json(sim_finished_timeline_page(parse_qs(query)))
            return
        if path == "/v1/codex/threads/sim-claude-handoff-thread":
            job = codex_fixture_handoff_job()
            self.send_json({
                "thread": codex_fixture_handoff_thread(),
                "messages": [
                    {"role": "user", "text": job["prompt"], "timestamp": job["createdAt"]},
                    {"role": "assistant", "text": job["result"], "timestamp": job["completedAt"]},
                ],
                "jobs": [job],
            })
            return
        if path == "/v1/codex/threads/sim-chat-thread":
            self.send_json(codex_fixture_chat_thread_detail())
            return
        if path == "/v1/codex/threads/sim-chat-thread-scoped":
            self.send_json(codex_fixture_scoped_chat_thread_detail())
            return
        if path == "/v1/codex/jobs/sim-job-linear":
            self.send_json(codex_fixture_job())
            return
        if path == "/v1/codex/jobs/sim-job-handoff":
            self.send_json(codex_fixture_handoff_job())
            return
        job_match = re.fullmatch(r"/v1/codex/jobs/([^/]+)(/stream|/timeline)?", path)
        scripted = sim_job_for(self.server, job_match.group(1)) if job_match else None
        if scripted is not None:
            if job_match.group(2) == "/stream":
                self.serve_codex_job_stream(scripted, parse_qs(query))
            elif job_match.group(2) == "/timeline":
                self.send_json(sim_timeline_page(self.server, scripted, parse_qs(query)))
            else:
                self.send_json(codex_fixture_running_job_tick(self.server, scripted))
            return
        if path == "/v1/codex/jobs/sim-job-approval":
            self.send_json(codex_fixture_approval_job(self.server))
            return
        artifact_match = re.fullmatch(
            r"/v1/codex/jobs/(sim-job-linear|sim-job-running|sim-job-\d+|sim-job-handoff)/artifacts/(artifact-001|artifact-002)/(raw|preview)",
            path,
        )
        if artifact_match:
            artifact_id = artifact_match.group(2)
            mode = artifact_match.group(3)
            if artifact_id == "artifact-001" and mode == "raw":
                self.send_file(_SIM_ARTIFACT_SCREENSHOT, "image/png")
                return
            if artifact_id == "artifact-002" and mode in {"raw", "preview"}:
                self.send_bytes(_SIM_ARTIFACT_PREVIEW, "text/html; charset=utf-8")
                return
            self.send_error(404)
            return
        terminal_stream_match = re.fullmatch(r"/v1/codex/terminals/([^/]+)/stream", path)
        if terminal_stream_match:
            self.serve_codex_terminal_stream(terminal_stream_match.group(1))
            return
        self.send_error(404)

    def serve_codex_terminal_stream(self, terminal_id: str) -> None:
        record = self.server.terminals.get(terminal_id)
        if record is None:
            self.send_json_error(404, "terminal was not found")
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache, no-transform")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True

        def emit(event: str, payload: dict) -> None:
            self.wfile.write(f"event: {event}\n".encode("utf-8"))
            self.wfile.write(f"data: {json.dumps(payload)}\n\n".encode("utf-8"))
            self.wfile.flush()

        emitted_version = -1
        try:
            for _ in range(240):
                with self.server.fixture_lock:
                    snapshot = dict(record["terminal"])
                    output = str(record["output"])
                    version = int(record["version"])
                if emitted_version == -1:
                    emit("snapshot", {"terminal": snapshot, "output": output})
                    emitted_version = version
                elif version != emitted_version:
                    emit("snapshot", {"terminal": snapshot, "output": output})
                    emitted_version = version
                if snapshot["status"] not in {"starting", "running"}:
                    emit("done", {"terminal": snapshot})
                    return
                self.wfile.write(b": heartbeat\n\n")
                self.wfile.flush()
                time.sleep(0.25)
        except (BrokenPipeError, ConnectionResetError):
            return

    def serve_codex_job_stream(self, job: "SimJob", query: dict | None = None) -> None:
        """Canned live-job SSE fixture mirroring /v1/codex/jobs/<id>/stream:
        status snapshot, stdout replay/live events with real byte offsets,
        heartbeat comments, then a terminal done event. A client that sends
        `timeline=<n>` also gets the scripted timeline as `timeline` events."""
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache, no-transform")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        delay = float(os.environ.get("SIM_JOB_STREAM_DELAY", "0.35"))

        def emit(event: str, payload: dict) -> None:
            self.wfile.write(f"event: {event}\n".encode("utf-8"))
            self.wfile.write(f"data: {json.dumps(payload)}\n\n".encode("utf-8"))
            self.wfile.flush()

        def emit_status(status: str) -> None:
            emit("status", {
                "id": job.id,
                "status": status,
                "provider": job.provider,
                "workspaceId": "poc-vault",
                "createdAt": job.created_at,
                "startedAt": job.started_at,
                "finishedAt": None,
                "updatedAt": sim_now_iso(),
                "exitCode": None,
                "timedOut": False,
                "error": None,
            })

        emit_status(sim_job_status(self.server, job) if job.timeline_enabled else "running")
        timeline_cursor = sim_timeline_cursor(self.server, job, query)
        if timeline_cursor is not None:
            opened = time.monotonic()
            # A resuming client names its offsets in the query or, like the real
            # daemon accepts, in Last-Event-ID ("<stdout>:<stderr>:<seq>").
            offsets = {key: (query or {}).get(key, [None])[0] for key in ("stdoutOffset", "stderrOffset")}
            resume = re.fullmatch(r"(\d{1,15}):(\d{1,15}):(\d{1,15})", (self.headers.get("Last-Event-ID") or "").strip())
            if resume:
                offsets = {"stdoutOffset": resume.group(1), "stderrOffset": resume.group(2)}
            stdout_offset = bounded_int(offsets["stdoutOffset"] or "0", 0, 0, 1 << 40)
            # One line per connection, so a re-attach can be read off the log:
            # what the client said it already held, and how the connection ended.
            sim_log(
                f"job-stream open job={job.id} "
                f"stdoutOffset={offsets['stdoutOffset'] or '-'} "
                f"stderrOffset={offsets['stderrOffset'] or '-'} "
                f"timeline={timeline_cursor} "
                f"lastEventId={(self.headers.get('Last-Event-ID') or '-')}"
            )
            outcome = "client-gone"
            self.sim_stream_sent = 0
            try:
                outcome = self.stream_sim_timeline(job, emit, emit_status, timeline_cursor, stdout_offset)
            except (BrokenPipeError, ConnectionResetError):
                pass
            sim_log(
                f"job-stream close job={job.id} reason={outcome} timelineEventsSent={self.sim_stream_sent} "
                f"through={timeline_cursor + self.sim_stream_sent} "
                f"seconds={time.monotonic() - opened:.1f}"
            )
            return
        offset = 0
        for chunk in ["Scanning workspace…\n", "Reading recent activity…\n", "Drafting summary…\n"]:
            emit("stdout", {"offset": offset, "text": chunk})
            offset += len(chunk.encode("utf-8"))
            self.wfile.write(b": heartbeat\n\n")
            self.wfile.flush()
            if delay > 0:
                time.sleep(delay)
        emit(
            "done",
            codex_fixture_job(
                status="succeeded",
                id=job.id,
                provider=job.provider,
                model=job.model,
                prompt=job.prompt,
            ),
        )

    def stream_sim_timeline(self, job: "SimJob", emit, emit_status, cursor: int, stdout_offset: int = 0) -> str:
        """Tail the scripted timeline from `cursor` until the run ends, then send
        `done`. Timeline messages carry no SSE id, as on a real machine.

        SIM_STREAM_DROP_AFTER=<n> closes each connection after n timeline events
        without sending `done`, the way a network drop does, so a client's
        re-attach can be exercised. SIM_TIMELINE_STDOUT=1 also streams the prose
        as `stdout` chunks with real byte offsets, from `stdoutOffset`."""
        drop_after = bounded_int(os.environ.get("SIM_STREAM_DROP_AFTER", "0"), 0, 0, 1_000_000)
        mirror_stdout = os.environ.get("SIM_TIMELINE_STDOUT", "0") == "1"
        sent = 0
        self.sim_stream_sent = 0
        last_status = sim_job_status(self.server, job)
        while True:
            with self.server.fixture_lock:
                pending = list(job.timeline[cursor:])
                finished = job.timeline_done
                stdout = bytes(job.stdout[stdout_offset:]) if mirror_stdout else b""
            if stdout:
                emit("stdout", {"offset": stdout_offset, "text": stdout.decode("utf-8", errors="replace")})
                stdout_offset += len(stdout)
            for index, event in enumerate(pending):
                cursor += 1
                sent += 1
                emit("timeline", {"seq": cursor, "event": event})
                self.sim_stream_sent = sent
                is_last_of_run = finished and index == len(pending) - 1
                if drop_after and sent >= drop_after and not is_last_of_run:
                    return "dropped"
            if finished and not pending:
                break
            status = sim_job_status(self.server, job)
            if status != last_status and status in {"running", "waiting_for_approval"}:
                # A state transition, as the real stream reports one.
                last_status = status
                emit_status(status)
            if not pending:
                self.wfile.write(b": heartbeat\n\n")
                self.wfile.flush()
                time.sleep(0.1)
        payload = sim_job_payload(self.server, job)
        payload["timelineEvents"] = cursor
        emit("done", payload)
        if mirror_stdout:
            sim_log(f"job-stream done job={job.id} stdoutBytes={stdout_offset} timelineEvents={cursor}")
        return "done"

