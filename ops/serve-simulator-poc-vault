    configured = os.environ.get("CODEX_MODEL_CATALOG")
    if configured:
        try:
            return public_catalog(json.loads(configured))
        except json.JSONDecodeError:
            pass

    opencode_models = opencode_fixture_models()
    if opencode_models:
        return opencode_models

    return [
        {
            "id": "anthropic.claude-3-5-sonnet-20241022-v2:0",
            "label": "Claude Sonnet (Bedrock)",
            "provider": "bedrock",
            "modes": ["chat"],
            "defaultOptions": {"temperature": 0.7, "maxTokens": 4096},
            "effortLevels": ["low", "medium", "high"],
        },
        {
            "id": "gpt-4o",
            "label": "GPT-4o (Azure)",
            "provider": "azure",
            "modes": ["chat"],
            "azureDeployment": "gpt-4o",
            "defaultOptions": {"temperature": 0.7, "maxTokens": 4096},
