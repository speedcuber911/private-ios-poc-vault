def sim_timeline_script() -> list[tuple[float, dict]]:
    """(pause before the event as a multiple of SIM_JOB_STREAM_DELAY, event).

    SIM_TIMELINE_REPEAT=<n> plays the turn n times over, with fresh ids each
    round, to make a transcript long enough to test scrolling."""
    rounds = bounded_int(os.environ.get("SIM_TIMELINE_REPEAT", "1"), 1, 1, 200)
    if rounds == 1:
        return sim_timeline_round()
    script: list[tuple[float, dict]] = []
    for round_index in range(rounds):
        tag = f"-{round_index + 1}"
        for pause, event in sim_timeline_round():
            if event.get("type") == "usage":
                if round_index < rounds - 1:
                    continue
            else:
                event = dict(event)
                event["id"] = f"{event['id']}{tag}"
                if "parent" in event:
                    event["parent"] = f"{event['parent']}{tag}"
            script.append((pause, event))
    return script


def sim_timeline_round() -> list[tuple[float, dict]]:
    script: list[tuple[float, dict]] = []

    def add(pause: float, **event: object) -> None:
        script.append((pause, dict(event)))

    def say(block: str, text: str, pause: float = 0.25) -> None:
        words = text.split(" ")
        for start in range(0, len(words), 4):
            chunk = " ".join(words[start:start + 4])
            if start + 4 < len(words):
                chunk += " "
            add(pause, type="text", id=block, delta=chunk)

    def run(step: str, lines: list[str], pause: float = 0.7) -> None:
