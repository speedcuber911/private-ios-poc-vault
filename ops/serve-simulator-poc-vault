"""Serve a local signed POC Vault manifest and static POCs for iOS Simulator."""

from __future__ import annotations

import argparse
import json
import mimetypes
import os
import re
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlparse


ROOT = Path(__file__).resolve().parents[1]
SLUG_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$")
_SIM_PREVIEW_TOKEN = "s" * 43
_SIM_LIVE_PREVIEW = b"""<!doctype html>
<html><head><meta name="viewport" content="width=device-width, initial-scale=1">
<style>
html,body{margin:0;min-height:100%;background:#101412;color:#f4f3ed;font:16px -apple-system,BlinkMacSystemFont,sans-serif}
main{padding:76px 24px 32px}small{color:#83d9c8;text-transform:uppercase;letter-spacing:.12em}h1{font-size:32px;margin:14px 0 8px}p{color:#b8beb9;line-height:1.5}.card{margin-top:24px;padding:18px;border:1px solid #2e3934;border-radius:16px;background:#171c19}
</style></head><body><main><small>Live from linked computer</small><h1>App preview is connected</h1><p>Relay opened this through the machine that ran the task.</p><div class="card">Root-relative assets and app routes stay inside this secure preview.</div></main></body></html>"""


class SimulatorVaultServer(ThreadingHTTPServer):
    def __init__(self, server_address: tuple[str, int], handler_class: type[BaseHTTPRequestHandler]):
        super().__init__(server_address, handler_class)
        self.manifest_dir = ROOT / "build" / "simulator"
        self.pocs_dir = ROOT / "pocs"
        self.approval_pending = True
        self.approval_resolution: dict | None = None
        self.terminals: dict[str, dict] = {}
        self.terminal_counter = 0
        self.active_job_provider = "codex"
        self.active_job_model: str | None = None
        self.active_job_prompt = "Inspect the workspace."
        self.active_job_tick = 0
        self.fixture_lock = threading.Lock()


class Handler(BaseHTTPRequestHandler):
    server: SimulatorVaultServer

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        path = unquote(parsed.path)
        query = parsed.query

        if path == "/healthz":
            self.send_bytes(b"ok\n", "text/plain")
            return
        if path == "/api/auth/get-session":
            self.send_json({"user": simulator_account_user()})
            return
        if path == "/v1/auth/device/link":
            self.send_json({"computer": simulator_computer_link()})
            return
        if path == "/v1/handoffs":
            self.send_json({"handoffs": [simulator_handoff()]})
            return
        if path == "/v1/handoffs/sim-handoff-4f89a2c1":
            handoff = simulator_handoff()
            handoff["manifest"] = simulator_handoff_manifest()
            self.send_json({"handoff": handoff})
            return
        if path == "/v1/mac-sessions":
            self.send_json({"index": simulator_mac_session_index()})
            return
        if path == "/v1/harness":
            self.send_json({"harnesses": simulator_harnesses()})
            return
        if path.startswith("/v1/codex/"):
            self.serve_codex_fixture(path, query)
            return
        if path == "/manifest.json":
            self.send_file(self.server.manifest_dir / "manifest.json", "application/json")
            return
        if path == "/manifest.sig.json":
            self.send_file(self.server.manifest_dir / "manifest.sig.json", "application/json")
            return
        if path.startswith("/pocs/"):
            self.serve_poc(path)
            return

        self.send_error(404)

    def do_POST(self) -> None:
        parsed = urlparse(self.path)
        path = unquote(parsed.path)
        if path in {"/api/auth/sign-up/email", "/api/auth/sign-in/username"}:
            self.read_json_body()
            self.send_json({"token": "relay-simulator-session", "user": simulator_account_user()})
            return
        if path == "/api/auth/sign-out":
            self.send_json({})
            return
        if path == "/api/auth/delete-user":
            self.send_json({"success": True, "message": "Simulator account deleted."})
            return
        if path == "/v1/handoffs/sim-handoff-4f89a2c1/continue":
            self.send_response(202)
            payload = json.dumps({
                "id": "sim-job-handoff",
                "job": codex_fixture_job(id="sim-job-handoff"),
            }).encode("utf-8")
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)
            return
        if path == "/v1/codex/chat":
            self.serve_codex_chat_fixture()
            return
        if path == "/v1/codex/jobs":
            body = self.read_json_body()
            provider = str(body.get("provider") or "codex")
            if provider not in {"codex", "claude", "cursor", "kimi"}:
                provider = "codex"
            model = body.get("model")
            prompt = body.get("prompt")
            with self.server.fixture_lock:
                self.server.active_job_provider = provider
                self.server.active_job_model = str(model) if isinstance(model, str) and model else None
                self.server.active_job_prompt = str(prompt) if isinstance(prompt, str) and prompt else "Inspect the workspace."
                self.server.active_job_tick = 0
            self.send_json({
                "id": "sim-job-running",
                "job": self.active_job_fixture(status="running", result=None),
            })
            return
        if path == "/v1/codex/previews":
            body = self.read_json_body()
            if body.get("jobId") not in {"sim-job-linear", "sim-job-running", "sim-job-handoff"}:
                self.send_json_error(404, "job not found")
                return
            if not str(body.get("url") or "").startswith(("http://localhost:4317", "http://127.0.0.1:4317")):
                self.send_json_error(400, "preview URL was not returned by this job")
                return
            self.send_json({
                "id": _SIM_PREVIEW_TOKEN,
                "url": f"/v1/codex/previews/{_SIM_PREVIEW_TOKEN}/",
                "expiresAt": "2026-08-18T01:00:00Z",
            }, status=201)
            return
        if path == "/v1/codex/jobs/sim-job-running/cancel":
            self.send_json(self.active_job_fixture(status="canceled", result="Simulator job canceled."))
            return
        approval_match = re.fullmatch(r"/v1/codex/approvals/([^/]+)/decision", path)
        if approval_match:
            if approval_match.group(1) != "sim-approval-shell":
                self.send_json_error(404, "approval was not found")
                return
            body = self.read_json_body()
            decision = str(body.get("decision") or "")
            if decision not in {"accept", "acceptForSession", "decline", "cancel"}:
                self.send_json_error(400, "decision is invalid")
                return
            with self.server.fixture_lock:
                self.server.approval_pending = False
                self.server.approval_resolution = {
                    "decision": decision,
                    "decidedAt": "2026-08-14T11:00:30Z",
                    "message": body.get("message"),
                }
            self.send_json({"approval": codex_fixture_approval(self.server)})
            return
        if path == "/v1/codex/terminals":
            body = self.read_json_body()
            workspace_id = str(body.get("workspaceId") or "")
            workspace = next((item for item in _SIM_WORKSPACES if item["id"] == workspace_id), None)
            if workspace is None:
                self.send_json_error(400, "unknown workspaceId")
                return
            with self.server.fixture_lock:
                self.server.terminal_counter += 1
                terminal_id = f"sim-terminal-{self.server.terminal_counter}"
                terminal = codex_fixture_terminal(
                    terminal_id,
                    workspace,
                    cols=bounded_int(body.get("cols"), 80, 20, 240),
                    rows=bounded_int(body.get("rows"), 24, 8, 100),
                )
                self.server.terminals[terminal_id] = {
                    "terminal": terminal,
                    "output": f"Relay terminal · {workspace['name']}\n$ ",
                    "version": 0,
                }
            self.send_json({"terminal": terminal})
            return
        terminal_input_match = re.fullmatch(r"/v1/codex/terminals/([^/]+)/input", path)
        if terminal_input_match:
            body = self.read_json_body()
            text = str(body.get("text") or "")
            record = self.server.terminals.get(terminal_input_match.group(1))
            if record is None:
                self.send_json_error(404, "terminal was not found")
                return
            with self.server.fixture_lock:
                command = text.strip()
                record["output"] += text
                if command == "pwd":
                    workspace_id = record["terminal"]["workspaceId"]
                    workspace = next(item for item in _SIM_WORKSPACES if item["id"] == workspace_id)
                    record["output"] += f"{workspace['path']}\n$ "
                elif command in {"exit", "logout"}:
                    record["output"] += "logout\n"
                    record["terminal"].update({
                        "status": "exited",
                        "updatedAt": "2026-08-14T11:01:00Z",
                        "finishedAt": "2026-08-14T11:01:00Z",
                        "exitCode": 0,
                    })
                elif command:
                    record["output"] += f"simulator: {command}\n$ "
                record["version"] += 1
            self.send_json({"terminal": record["terminal"]})
            return
        terminal_close_match = re.fullmatch(r"/v1/codex/terminals/([^/]+)/close", path)
        if terminal_close_match:
            record = self.server.terminals.get(terminal_close_match.group(1))
            if record is None:
                self.send_json_error(404, "terminal was not found")
                return
            with self.server.fixture_lock:
                record["terminal"].update({
                    "status": "closed",
                    "updatedAt": "2026-08-14T11:01:00Z",
                    "finishedAt": "2026-08-14T11:01:00Z",
                    "exitCode": record["terminal"].get("exitCode"),
                })
                record["version"] += 1
            self.send_json({"terminal": record["terminal"]})
            return
        if path == "/v1/codex/transcriptions":
            self.send_json({"text": "Simulator voice transcript", "durationMs": 1200})
            return
        if path == "/v1/codex/workspaces/select":
            self.send_json(codex_fixture_workspace())
            return
        if path == "/v1/codex/workspaces/create":
            self.send_json(codex_fixture_workspace(id="sim-new-workspace", name="New Workspace", path="/srv/codex-workspaces/new-workspace"))
            return
        self.send_error(404)

    def do_DELETE(self) -> None:
        path = unquote(urlparse(self.path).path)
        if path == "/v1/auth/device/link":
            self.send_json({"ok": True})
            return
        self.send_error(404)

    def serve_codex_fixture(self, path: str, query: str) -> None:
        if path == "/v1/codex/health":
            self.send_json({"ok": True, "status": "ok", "message": "Simulator Codex fixture"})
            return
        if path == "/v1/codex/models":
            self.send_json({"models": codex_fixture_models()})
            return
        if path == f"/v1/codex/previews/{_SIM_PREVIEW_TOKEN}/":
            self.send_bytes(_SIM_LIVE_PREVIEW, "text/html; charset=utf-8")
            return
        if path == "/v1/codex/skills":
            provider = parse_qs(query).get("provider", ["codex"])[0]
            if provider not in {"codex", "claude", "cursor", "kimi"}:
                self.send_json_error(400, "provider is invalid")
                return
            self.send_json({"provider": provider, "skills": codex_fixture_skills(provider)})
            return
        if path == "/v1/codex/approvals":
            params = parse_qs(query)
            approval = codex_fixture_approval(self.server)
            approvals = [approval]
            job_id = params.get("jobId", [""])[0]
            status = params.get("status", [""])[0]
            if job_id and job_id != approval["jobId"]:
                approvals = []
            if status and status != approval["status"]:
                approvals = []
            self.send_json({"approvals": approvals})
            return
        if path == "/v1/codex/workspaces":
            self.send_json({"workspaces": codex_fixture_workspaces()})
            return
        if path == "/v1/codex/workspace-dirs":
            self.send_json(codex_fixture_workspace_dirs(parse_qs(query).get("path", [""])[0]))
            return
        if path == "/v1/codex/fs/list":
            self.serve_codex_fs_list(parse_qs(query))
            return
        if path == "/v1/codex/fs/file":
            self.serve_codex_fs_file(parse_qs(query))
            return
        if path == "/v1/codex/jobs":
            self.send_json({"jobs": [codex_fixture_approval_job(self.server), codex_fixture_job()]})
            return
        if path == "/v1/codex/sessions":
            self.send_json({"sessions": [codex_fixture_session()]})
            return
        if path == "/v1/codex/threads":
            workspace_id = parse_qs(query).get("workspaceId", [""])[0]
            threads = [codex_fixture_thread(), codex_fixture_chat_thread(), codex_fixture_scoped_chat_thread()]
            if workspace_id:
                # Workspace filters merge task and chat threads for that folder;
                # legacy null-workspace chats stay global-only.
                threads = [t for t in threads if t.get("workspaceId") == workspace_id]
            threads.sort(key=lambda t: t.get("updatedAt") or "", reverse=True)
            self.send_json({"threads": threads})
            return
        if path == "/v1/codex/threads/sim-thread-linear":
            self.send_json(codex_fixture_thread_detail())
            return
        if path == "/v1/codex/threads/sim-chat-thread":
            self.send_json(codex_fixture_chat_thread_detail())
            return
        if path == "/v1/codex/threads/sim-chat-thread-scoped":
            self.send_json(codex_fixture_scoped_chat_thread_detail())
            return
        if path == "/v1/codex/jobs/sim-job-linear":
            self.send_json(codex_fixture_job())
            return
        if path == "/v1/codex/jobs/sim-job-running":
            self.send_json(codex_fixture_running_job_tick(self.server))
            return
        if path == "/v1/codex/jobs/sim-job-running/stream":
            self.serve_codex_job_stream()
            return
        if path == "/v1/codex/jobs/sim-job-approval":
            self.send_json(codex_fixture_approval_job(self.server))
            return
        artifact_match = re.fullmatch(
            r"/v1/codex/jobs/(sim-job-linear|sim-job-running|sim-job-handoff)/artifacts/(artifact-001|artifact-002)/(raw|preview)",
            path,
        )
        if artifact_match:
            artifact_id = artifact_match.group(2)
            mode = artifact_match.group(3)
            if artifact_id == "artifact-001" and mode == "raw":
                self.send_file(_SIM_ARTIFACT_SCREENSHOT, "image/png")
                return
            if artifact_id == "artifact-002" and mode in {"raw", "preview"}:
                self.send_bytes(_SIM_ARTIFACT_PREVIEW, "text/html; charset=utf-8")
                return
            self.send_error(404)
            return
        terminal_stream_match = re.fullmatch(r"/v1/codex/terminals/([^/]+)/stream", path)
        if terminal_stream_match:
            self.serve_codex_terminal_stream(terminal_stream_match.group(1))
            return
        self.send_error(404)

    def serve_codex_terminal_stream(self, terminal_id: str) -> None:
        record = self.server.terminals.get(terminal_id)
        if record is None:
            self.send_json_error(404, "terminal was not found")
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache, no-transform")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True

        def emit(event: str, payload: dict) -> None:
            self.wfile.write(f"event: {event}\n".encode("utf-8"))
            self.wfile.write(f"data: {json.dumps(payload)}\n\n".encode("utf-8"))
            self.wfile.flush()

        emitted_version = -1
        try:
            for _ in range(240):
                with self.server.fixture_lock:
                    snapshot = dict(record["terminal"])
                    output = str(record["output"])
                    version = int(record["version"])
                if emitted_version == -1:
                    emit("snapshot", {"terminal": snapshot, "output": output})
                    emitted_version = version
                elif version != emitted_version:
                    emit("snapshot", {"terminal": snapshot, "output": output})
                    emitted_version = version
                if snapshot["status"] not in {"starting", "running"}:
                    emit("done", {"terminal": snapshot})
                    return
                self.wfile.write(b": heartbeat\n\n")
                self.wfile.flush()
                time.sleep(0.25)
        except (BrokenPipeError, ConnectionResetError):
            return

    def serve_codex_job_stream(self) -> None:
        """Canned live-job SSE fixture mirroring /v1/codex/jobs/<id>/stream:
        status snapshot, stdout replay/live events with real byte offsets,
        heartbeat comments, then a terminal done event."""
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache, no-transform")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        delay = float(os.environ.get("SIM_JOB_STREAM_DELAY", "0.35"))

        def emit(event: str, payload: dict) -> None:
            self.wfile.write(f"event: {event}\n".encode("utf-8"))
            self.wfile.write(f"data: {json.dumps(payload)}\n\n".encode("utf-8"))
            self.wfile.flush()

        with self.server.fixture_lock:
            provider = self.server.active_job_provider
            model = self.server.active_job_model
            prompt = self.server.active_job_prompt

        emit("status", {
            "id": "sim-job-running",
            "status": "running",
            "provider": provider,
            "model": model,
            "workspaceId": "poc-vault",
            "createdAt": "2026-05-23T13:34:00Z",
            "startedAt": "2026-05-23T13:34:02Z",
            "finishedAt": None,
            "updatedAt": "2026-05-23T13:34:02Z",
            "exitCode": None,
            "timedOut": False,
            "error": None,
        })
        offset = 0
        for chunk in ["Scanning workspace…\n", "Reading recent activity…\n", "Drafting summary…\n"]:
            emit("stdout", {"offset": offset, "text": chunk})
            offset += len(chunk.encode("utf-8"))
            self.wfile.write(b": heartbeat\n\n")
            self.wfile.flush()
            if delay > 0:
                time.sleep(delay)
        emit(
            "done",
            codex_fixture_job(
                status="succeeded",
                id="sim-job-running",
                provider=provider,
                model=model,
                prompt=prompt,
            ),
        )

    def active_job_fixture(self, status: str, result: str | None) -> dict:
        with self.server.fixture_lock:
            return codex_fixture_job(
                status=status,
                result=result,
                id="sim-job-running",
                provider=self.server.active_job_provider,
                model=self.server.active_job_model,
                prompt=self.server.active_job_prompt,
            )

    def serve_codex_chat_fixture(self) -> None:
        body = self.read_json_body()
        provider = str(body.get("provider") or "bedrock")
        model = str(body.get("model") or "anthropic.claude-3-5-sonnet-20241022-v2:0")
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache, no-transform")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        # Paced, markdown-rich fixture so the streaming UI (typing dots -> caret -> growing
        # text -> usage footer) is observable when screenshotting. Simulator only.
        delta_delay = float(os.environ.get("SIM_CHAT_DELTA_DELAY", "0.28"))
        deltas = [
            "Connection pooling ",
            "reuses a set of open database connections ",
            "instead of opening a new one per request.\n\n",
            "**Why it helps**\n",
            "- Skips the TCP + auth handshake on every query\n",
            "- Caps total concurrent connections to protect the DB\n",
            "- Cuts tail latency under load\n\n",
            "```python\n",
            "pool = ConnectionPool(max_size=10)\n",
            "with pool.connection() as conn:\n",
            "    conn.execute(query)\n",
            "```\n",
            "The connection returns to the pool on close rather than tearing down.",
        ]
        workspace_id = body.get("workspaceId") or None
        thread_id = "sim-chat-thread-scoped" if workspace_id else "sim-chat-thread"
        events = [("meta", {"threadId": thread_id, "model": model, "provider": provider, "workspaceId": workspace_id})]
        events += [("delta", {"text": chunk}) for chunk in deltas]
        events += [
            ("usage", {"inputTokens": 18, "outputTokens": 96}),
            ("done", {"stopReason": "simulator"}),
        ]
        for event, payload in events:
            self.wfile.write(f"event: {event}\n".encode("utf-8"))
            self.wfile.write(f"data: {json.dumps(payload)}\n\n".encode("utf-8"))
            self.wfile.flush()
            if event == "delta" and delta_delay > 0:
                time.sleep(delta_delay)

    def do_HEAD(self) -> None:
        parsed = urlparse(self.path)
        path = unquote(parsed.path)
        if path == "/v1/codex/fs/file":
            self.serve_codex_fs_file(parse_qs(parsed.query), head_only=True)
            return
        self.send_error(404)

    def serve_codex_fs_list(self, query: dict) -> None:
        requested = (query.get("path", [""])[0] or "").strip()
        listing = codex_fixture_fs_list(requested, query)
        if listing is None:
            self.send_json_error(404, "workspace directory was not found")
            return
        self.send_json(listing)

    def serve_codex_fs_file(self, query: dict, head_only: bool = False) -> None:
        requested = (query.get("path", [""])[0] or "").strip()
        node = sim_fs_node(requested)
        if node is None or node.get("kind") != "file":
            self.send_json_error(404, "file was not found")
            return
        if node.get("denied"):
            self.send_json_error(403, "file matches the read denylist")
            return

        content = sim_fs_content(node)
        size = len(content)
        mime = node.get("mime", "text/plain; charset=utf-8")
        status = 200
        start = 0
        end = min(size, _SIM_FS_MAX_READ_BYTES) - 1
        range_header = self.headers.get("Range")
        if range_header:
            byte_range = sim_parse_byte_range(range_header, size)
            if byte_range is None:
                self.send_response(416)
                self.send_header("Content-Range", f"bytes */{size}")
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.end_headers()
                return
            status = 206
            start, end = byte_range
            end = min(end, start + _SIM_FS_MAX_READ_BYTES - 1)
        elif size > _SIM_FS_MAX_READ_BYTES:
            status = 206

        body = content[start : end + 1]
        active = mime.startswith("text/html") or mime.startswith("image/svg")
        disposition = "attachment" if active or not node.get("inline", True) else "inline"
        self.send_response(status)
        self.send_header("Content-Type", mime)
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Content-Disposition", f'{disposition}; filename="{requested.rsplit("/", 1)[-1]}"')
        if status == 206:
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.end_headers()
        if not head_only:
            self.wfile.write(body)

    def send_json_error(self, status: int, message: str) -> None:
        payload = json.dumps({"error": message}).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def read_json_body(self) -> dict:
        length = int(self.headers.get("Content-Length") or "0")
        if length <= 0:
            return {}
        try:
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except (json.JSONDecodeError, UnicodeDecodeError):
            return {}

    def serve_poc(self, path: str) -> None:
        parts = path.strip("/").split("/", 2)
        if len(parts) < 2 or parts[0] != "pocs":
            self.send_error(404)
            return

        slug = parts[1]
        if not SLUG_RE.fullmatch(slug):
            self.send_error(404)
            return

        relative = parts[2] if len(parts) == 3 and parts[2] else "index.html"
        if relative.endswith("/"):
            relative += "index.html"

        candidate = (self.server.pocs_dir / slug / "public" / relative).resolve()
        public_root = (self.server.pocs_dir / slug / "public").resolve()
        if not str(candidate).startswith(str(public_root)) or not candidate.is_file():
            self.send_error(404)
            return

        self.send_file(candidate)

    def send_file(self, path: Path, content_type: str | None = None) -> None:
        if not path.is_file():
            self.send_error(404)
            return
        guessed = content_type or mimetypes.guess_type(path.name)[0] or "application/octet-stream"
        self.send_bytes(path.read_bytes(), guessed)

    def send_bytes(self, payload: bytes, content_type: str, status: int = 200) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def send_json(self, payload: dict, status: int = 200) -> None:
        self.send_bytes(json.dumps(payload).encode("utf-8"), "application/json", status=status)

    def log_message(self, format: str, *args: object) -> None:
        sys.stderr.write("sim-vault: " + format % args + "\n")


