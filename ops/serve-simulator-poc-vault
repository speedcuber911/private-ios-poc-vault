def _sim_norm_path(raw: str | None) -> str:
    value = (raw or "").strip()
    while len(value) > 1 and value.endswith("/"):
        value = value[:-1]
    return value


def _sim_slugify_worktree(value: str) -> str | None:
    slug = re.sub(r"[^a-z0-9._-]+", "-", value.strip().lower())
    slug = re.sub(r"--+", "-", slug).strip(".-")[:64]
    if not slug or slug in {".", ".."}:
        return None
    return slug


def _sim_build_hunk(
    old_start: int,
    new_start: int,
    raw_lines: list[tuple[str, str]],
    header_context: str = "",
) -> dict:
    old_line = old_start
    new_line = new_start
    old_count = 0
    new_count = 0
    lines: list[dict] = []
    for prefix, text in raw_lines:
        if prefix == "+":
            lines.append({"kind": "add", "oldLine": None, "newLine": new_line, "text": text})
            new_line += 1
            new_count += 1
        elif prefix == "-":
            lines.append({"kind": "del", "oldLine": old_line, "newLine": None, "text": text})
            old_line += 1
            old_count += 1
        else:
            lines.append({"kind": "context", "oldLine": old_line, "newLine": new_line, "text": text})
            old_line += 1
            new_line += 1
            old_count += 1
            new_count += 1
    suffix = f" {header_context}" if header_context else ""
    return {
        "header": f"@@ -{old_start},{old_count} +{new_start},{new_count} @@{suffix}",
        "oldStart": old_start,
        "oldCount": old_count,
        "newStart": new_start,
        "newCount": new_count,
        "lines": lines,
    }


def _sim_build_diff_file(
    path: str,
    *,
    status: str = "modified",
    staged: bool = False,
    unstaged: bool = True,
    old_path: str | None = None,
    binary: bool = False,
    hunks: list[dict] | None = None,
) -> dict:
    hunk_list = list(hunks or [])
    added = sum(1 for h in hunk_list for ln in h["lines"] if ln["kind"] == "add")
    deleted = sum(1 for h in hunk_list for ln in h["lines"] if ln["kind"] == "del")
    return {
        "path": path,
        "oldPath": old_path,
        "status": status,
        "staged": staged,
        "unstaged": unstaged,
        "added": added,
        "deleted": deleted,
        "binary": binary,
        "hunks": hunk_list,
    }


def _sim_diff_file_public(entry: dict) -> dict:
    return {
        "path": entry["path"],
        "oldPath": entry.get("oldPath"),
        "status": entry["status"],
        "added": entry["added"],
        "deleted": entry["deleted"],
        "binary": entry.get("binary", False),
        "hunks": entry.get("hunks", []),
    }


