def sim_fs_relative(requested: str) -> str | None:
    text = (requested or "").strip().strip("/")
    if text.startswith(_SIM_WORKSPACE_ROOT.strip("/")):
        text = text[len(_SIM_WORKSPACE_ROOT.strip("/")):].strip("/")
    if ".." in text.split("/"):
        return None
    return text


def sim_fs_node(requested: str) -> dict | None:
    relative = sim_fs_relative(requested)
    if relative is None:
        return None
    node: dict = {"kind": "dir", "children": _SIM_FS_TREE}
    for segment in [part for part in relative.split("/") if part]:
        children = node.get("children", {})
        if segment not in children:
            return None
        node = children[segment]
    return node


def sim_fs_content(node: dict) -> bytes:
    if "content_fn" in node:
        return node["content_fn"]()
    return node.get("content", b"")


def sim_parse_byte_range(value: str, size: int) -> tuple[int, int] | None:
    match = re.fullmatch(r"bytes=(\d*)-(\d*)", value.strip())
    if not match or (match.group(1) == "" and match.group(2) == ""):
        return None
    if match.group(1) == "":
        suffix = int(match.group(2))
        if suffix <= 0 or size == 0:
            return None
        return (max(0, size - suffix), size - 1)
    start = int(match.group(1))
    if start >= size:
        return None
    end = size - 1 if match.group(2) == "" else min(int(match.group(2)), size - 1)
    if end < start:
        return None
    return (start, end)


