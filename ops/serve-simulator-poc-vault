def sim_fs_relative(requested: str) -> str | None:
    text = (requested or "").strip().strip("/")
    if text.startswith(_SIM_WORKSPACE_ROOT.strip("/")):
        text = text[len(_SIM_WORKSPACE_ROOT.strip("/")):].strip("/")
    if ".." in text.split("/"):
        return None
    return text


def sim_fs_node(requested: str) -> dict | None:
    relative = sim_fs_relative(requested)
    if relative is None:
        return None
    node: dict = {"kind": "dir", "children": _SIM_FS_TREE}
    for segment in [part for part in relative.split("/") if part]:
        children = node.get("children", {})
        if segment not in children:
            return None
        node = children[segment]
    return node


def sim_fs_content(node: dict) -> bytes:
    if "content_fn" in node:
        return node["content_fn"]()
    return node.get("content", b"")


def sim_parse_byte_range(value: str, size: int) -> tuple[int, int] | None:
    match = re.fullmatch(r"bytes=(\d*)-(\d*)", value.strip())
    if not match or (match.group(1) == "" and match.group(2) == ""):
        return None
    if match.group(1) == "":
        suffix = int(match.group(2))
        if suffix <= 0 or size == 0:
            return None
        return (max(0, size - suffix), size - 1)
    start = int(match.group(1))
    if start >= size:
        return None
    end = size - 1 if match.group(2) == "" else min(int(match.group(2)), size - 1)
    if end < start:
        return None
    return (start, end)


def codex_fixture_fs_list(requested: str, query: dict) -> dict | None:
    relative = sim_fs_relative(requested)
    node = sim_fs_node(requested)
    if relative is None or node is None or node.get("kind") != "dir":
        return None

    registered = {ws["id"]: ws for ws in _SIM_WORKSPACES}
    dirs = []
    files = []
    for name, child in sorted(node.get("children", {}).items()):
        child_rel = f"{relative}/{name}" if relative else name
        absolute = f"{_SIM_WORKSPACE_ROOT}/{child_rel}"
        if child.get("kind") == "dir":
            workspace_id = child_rel if child_rel in registered else "dir-" + child_rel.replace("/", "-")
            workspace_name = registered.get(child_rel, {}).get("name") or child_rel.replace("/", " / ")
            dirs.append({
                "name": name,
                "kind": "dir",
                "path": child_rel,
                "absolutePath": absolute,
                "modifiedAt": "2026-08-09T00:00:00.000Z",
                "workspaceId": workspace_id,
                "workspaceName": workspace_name,
                "hasGit": name == "ai-tutor",
                "isRegistered": child_rel in registered,
            })
        else:
            files.append({
                "name": name,
                "kind": "file",
                "path": child_rel,
                "absolutePath": absolute,
                "size": len(sim_fs_content(child)),
                "modifiedAt": "2026-08-09T00:00:00.000Z",
