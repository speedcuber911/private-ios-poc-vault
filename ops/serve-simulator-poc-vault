def sim_git_diff(server: SimulatorVaultServer, query: dict) -> tuple[int, dict]:
    requested = (query.get("path", [""])[0] or "").strip()
    mode = (query.get("mode", ["uncommitted"])[0] or "uncommitted").strip().lower()
    if mode not in {"uncommitted", "committed", "all"}:
        return (400, {"error": "mode must be uncommitted, committed, or all"})
    file_filter = (query.get("file", [""])[0] or "").strip() or None

    with server.fixture_lock:
        _, repo = _sim_resolve_git_repo_unlocked(server, requested)
        if repo is None:
            return (400, {"error": "directory is not a git repository"})

        if mode == "uncommitted":
            selected = list(repo["uncommitted_files"])
        elif mode == "committed":
            selected = list(repo["committed_files"])
        else:
            merged_by_path: dict[str, dict] = {}
            for item in repo["committed_files"]:
                merged_by_path[item["path"]] = dict(item, hunks=list(item["hunks"]))
            for item in repo["uncommitted_files"]:
                existing = merged_by_path.get(item["path"])
                if existing is None:
                    merged_by_path[item["path"]] = dict(item, hunks=list(item["hunks"]))
                else:
                    existing["hunks"] = existing["hunks"] + list(item["hunks"])
                    existing["added"] = existing["added"] + item["added"]
                    existing["deleted"] = existing["deleted"] + item["deleted"]
            selected = list(merged_by_path.values())

        if file_filter:
            selected = [f for f in selected if f["path"] == file_filter]

        public_files = [_sim_diff_file_public(f) for f in selected]
        total_added = sum(f["added"] for f in public_files)
        total_deleted = sum(f["deleted"] for f in public_files)
        return (
            200,
            {
                "mode": mode,
                "branch": repo["branch"],
                "baseBranch": repo["baseBranch"],
                "totalAdded": total_added,
                "totalDeleted": total_deleted,
                "truncated": False,
                "files": public_files,
            },
        )


