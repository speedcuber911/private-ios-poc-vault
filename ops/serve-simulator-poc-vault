def sim_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def start_sim_timeline(server: SimulatorVaultServer, job: SimJob) -> None:
    enabled = os.environ.get("SIM_TIMELINE", "1") != "0"
    asks_approval = os.environ.get("SIM_TIMELINE_APPROVAL", "0") == "1"
    now = sim_now_iso()
    with server.fixture_lock:
        job.generation += 1
        generation = job.generation
        job.timeline = []
        job.stdout = bytearray()
        job.timeline_enabled = enabled
        job.timeline_done = not enabled
        job.final_status = "succeeded"
        # Real times, so a duration counted from them is a real duration.
        job.created_at = now
        job.started_at = now
        job.completed_at = None
    if not enabled:
        return
    delay = float(os.environ.get("SIM_JOB_STREAM_DELAY", "0.35"))

    def finish(status: str) -> None:
        with server.fixture_lock:
            if job.generation == generation:
                job.final_status = status
                job.timeline_done = True
                job.completed_at = sim_now_iso()

    def run() -> None:
        started: set[str] = set()
        asked = False
        for pause, event in sim_timeline_script():
            if delay > 0 and pause > 0:
                time.sleep(delay * pause)
            if event.get("type") == "step":
                # Stamp real times so the phone's ticking durations are honest.
                now = sim_now_iso()
                if event["id"] not in started:
                    started.add(event["id"])
                    event.setdefault("startedAt", now)
                if event.get("status") in {"done", "failed", "cancelled"}:
                    event.setdefault("endedAt", now)
            with server.fixture_lock:
                if job.generation != generation:
                    return
                job.timeline.append(event)
                if event.get("type") == "text":
                    job.stdout += str(event.get("delta") or "").encode("utf-8")
            is_first_command = event.get("type") == "step" and event.get("kind") == "command" and not asked
            if asks_approval and is_first_command:
                asked = True
                command = (event.get("input") or {}).get("command") or "npm test"
                with server.fixture_lock:
                    job.approval = {
                        "id": f"sim-approval-{job.id}",
                        "jobId": job.id,
                        "provider": job.provider,
                        "kind": "tool",
                        "title": "Run a command",
                        "reason": "The agent needs permission before it can run this command.",
                        "command": command,
                        "cwd": "/srv/codex-workspaces/poc-vault",
                        "toolName": "Bash",
                        "createdAt": sim_now_iso(),
                        "status": "pending",
                        "availableDecisions": ["accept", "acceptForSession", "decline", "cancel"],
                        "resolution": None,
                    }
                    job.waiting_for_approval = True
                # Parked, like the real runner, until the phone decides.
                while True:
                    with server.fixture_lock:
                        if job.generation != generation:
                            return
                        if not job.waiting_for_approval:
                            decision = ((job.approval or {}).get("resolution") or {}).get("decision")
                            break
                    time.sleep(0.1)
                if decision in {"decline", "cancel"}:
                    with server.fixture_lock:
                        job.timeline.append({
                            "type": "step", "id": event["id"], "status": "cancelled",
                            "endedAt": sim_now_iso(), "error": "Declined on the phone.",
                        })
                    finish("canceled")
                    return
        finish("succeeded")

    threading.Thread(target=run, daemon=True).start()


def sim_job_for(server: SimulatorVaultServer, job_id: str) -> SimJob | None:
    """A submitted job by id; `sim-job-running` is the latest one."""
    with server.fixture_lock:
        if job_id == "sim-job-running":
            return server.active_job
        return server.sim_jobs.get(job_id)


def sim_job_for_approval(server: SimulatorVaultServer, approval_id: str) -> SimJob | None:
    with server.fixture_lock:
        for job in server.sim_jobs.values():
            if job.approval and job.approval["id"] == approval_id:
                return job
    return None


def sim_job_status(server: SimulatorVaultServer, job: SimJob) -> str:
    with server.fixture_lock:
        if not job.timeline_done:
            return "waiting_for_approval" if job.waiting_for_approval else "running"
        return job.final_status


def sim_job_payload(server: SimulatorVaultServer, job: SimJob) -> dict:
    """The job object of a scripted run. Its status comes from the script's own
    state and nothing else: it is `running` until the last event is out."""
    status = sim_job_status(server, job) if job.timeline_enabled else "running"
    if status == "succeeded":
        result: str | None = _SIM_TIMELINE_ANSWER
    elif status in {"running", "waiting_for_approval"}:
        result = None
    else:
        result = "Simulator job canceled."
    payload = codex_fixture_job(
        status=status,
        result=result,
        id=job.id,
        provider=job.provider,
        model=job.model,
        prompt=job.prompt,
    )
    with server.fixture_lock:
        payload["createdAt"] = job.created_at
        payload["startedAt"] = job.started_at
        payload["completedAt"] = job.completed_at
        payload["updatedAt"] = job.completed_at or sim_now_iso()
        if job.timeline_enabled and job.timeline:
            payload["timelineEvents"] = len(job.timeline)
    return payload


def sim_timeline_cursor(server: SimulatorVaultServer, job: SimJob, query: dict | None) -> int | None:
    """The client's timeline cursor, or None when it did not ask for a timeline
    or this run has none (then the stream is the legacy one, unchanged)."""
    values = (query or {}).get("timeline")
    if not values:
        return None
    with server.fixture_lock:
        if not job.timeline_enabled:
            return None
    return bounded_int(values[0], 0, 0, 1_000_000)


def sim_timeline_page(server: SimulatorVaultServer, job: SimJob, query: dict) -> dict:
    since = bounded_int((query.get("since") or ["0"])[0], 0, 0, 1_000_000)
    with server.fixture_lock:
        events = list(job.timeline)
        finished = job.timeline_done
    since = min(since, len(events))
    page = events[since:since + 2000]
    next_cursor = since + len(page)
    return {
        "jobId": job.id,
        "events": [{"seq": since + index + 1, "event": event} for index, event in enumerate(page)],
        "next": next_cursor,
        "complete": finished and next_cursor == len(events),
    }


# Drives a simulated job lifecycle across poll ticks so the Task tab's live job card
# shows queued -> running (growing logs) -> succeeded instead of a frozen card.
_SIM_JOB_STAGES = [
    ("running", "Scanning workspace…"),
    ("running", "Scanning workspace…\nReading recent activity…"),
    ("running", "Scanning workspace…\nReading recent activity…\nDrafting summary…"),
]


def codex_fixture_running_job_tick(server: SimulatorVaultServer, job: SimJob) -> dict:
    if job.timeline_enabled:
        # A scripted run ends when its timeline does, not after N polls, so the
        # poll and the stream never disagree about whether the job is over.
        return sim_job_payload(server, job)
    with server.fixture_lock:
        n = job.tick
        job.tick = n + 1
        final_status = job.final_status
    stamps = {"createdAt": job.created_at, "startedAt": job.started_at}
    if final_status == "canceled":
        return {**codex_fixture_job(status="canceled", result="Simulator job canceled.", id=job.id,
                                    provider=job.provider, model=job.model, prompt=job.prompt), **stamps}
    if n < len(_SIM_JOB_STAGES):
        status, log = _SIM_JOB_STAGES[n]
        return {**codex_fixture_job(
            status="running",
            result=log,
            id=job.id,
            provider=job.provider,
            model=job.model,
            prompt=job.prompt,
        ), **stamps}
    # After the running stages, complete the job (same id so the card updates in place).
    with server.fixture_lock:
        if job.completed_at is None:
            job.completed_at = sim_now_iso()
    return {**codex_fixture_job(
        status="succeeded",
        id=job.id,
        provider=job.provider,
        model=job.model,
        prompt=job.prompt,
    ), **stamps, "completedAt": job.completed_at, "updatedAt": job.completed_at}


