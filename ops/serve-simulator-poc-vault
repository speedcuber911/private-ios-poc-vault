# Drives a simulated job lifecycle across poll ticks so the Task tab's live job card
# shows queued -> running (growing logs) -> succeeded instead of a frozen card.
_SIM_JOB_TICKS = {"n": 0}
_SIM_JOB_STAGES = [
    ("running", "Scanning workspace…"),
    ("running", "Scanning workspace…\nReading recent activity…"),
    ("running", "Scanning workspace…\nReading recent activity…\nDrafting summary…"),
]


def codex_fixture_running_job_tick() -> dict:
    n = _SIM_JOB_TICKS["n"]
    _SIM_JOB_TICKS["n"] = n + 1
    if n < len(_SIM_JOB_STAGES):
        status, log = _SIM_JOB_STAGES[n]
        return codex_fixture_job(status="running", result=log, id="sim-job-running")
    # After the running stages, complete the job (same id so the card updates in place).
    _SIM_JOB_TICKS["n"] = 0  # reset for the next submitted job
    return codex_fixture_job(status="succeeded", id="sim-job-running")


def codex_fixture_job(status: str = "succeeded", result: str | None = None, id: str | None = None) -> dict:
    result_text = codex_fixture_answer() if result is None and status == "succeeded" else result
    return {
        "id": id or ("sim-job-linear" if status == "succeeded" else "sim-job-running"),
        "provider": "codex",
        "status": status,
        "workspaceId": "poc-vault",
        "workspaceName": "POC Vault",
        "prompt": "List out all my linear issues for last one week and also carve out my action items from them.",
        "result": result_text,
        "resultTruncated": False,
        "logsIncluded": "compact",
        "sessionId": "sim-thread-linear",
        "createdAt": "2026-05-23T13:34:00Z",
        "startedAt": "2026-05-23T13:34:02Z",
        "completedAt": None if status == "running" else "2026-05-23T13:35:30Z",
        "updatedAt": "2026-05-23T13:35:30Z",
    }


def refresh_manifest(host: str, port: int) -> None:
    manifest_dir = ROOT / "build" / "simulator"
    manifest_dir.mkdir(parents=True, exist_ok=True)
    manifest_path = manifest_dir / "manifest.json"
    signature_path = manifest_dir / "manifest.sig.json"
    base_url = f"http://{host}:{port}/pocs/{{slug}}"

    subprocess.run(
        [
            sys.executable,
            str(ROOT / "ops" / "render-manifest.py"),
            "--pocs-dir",
            str(ROOT / "pocs"),
            "--base-url",
            base_url,
            "-o",
            str(manifest_path),
        ],
        cwd=ROOT,
        check=True,
    )
    subprocess.run(
        [
            sys.executable,
            str(ROOT / "ops" / "sign-manifest.py"),
            str(manifest_path),
            "-o",
            str(signature_path),
        ],
        cwd=ROOT,
        check=True,
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8787)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    refresh_manifest(args.host, args.port)
    server = SimulatorVaultServer((args.host, args.port), Handler)
    print(f"POC Vault simulator server on http://{args.host}:{args.port}")
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
