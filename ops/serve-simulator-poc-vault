def sim_git_checkout(server: SimulatorVaultServer, body: dict) -> tuple[int, dict]:
    raw_branch = body.get("branch")
    if not isinstance(raw_branch, str) or not raw_branch.strip():
        return (400, {"error": "branch is required"})
    branch = raw_branch.strip()
    if branch.startswith("-") or branch in {"HEAD", "@"} or ".." in branch or " " in branch:
        return (400, {"error": "invalid branch name"})
    create = bool(body.get("create", False))

    with server.fixture_lock:
        repo_path, repo = _sim_resolve_git_repo_unlocked(server, body.get("path"))
        if repo is None or repo_path is None:
            return (400, {"error": "directory is not a git repository"})

        local_names = {b["name"] for b in repo["branches"] if not b["isRemote"]}
        remote_names = {b["name"] for b in repo["branches"] if b["isRemote"]}
        if create:
            if branch in local_names:
                return (409, {"error": f"a branch named '{branch}' already exists"})
            repo["branches"].append({
                "name": branch,
                "isCurrent": True,
                "isRemote": False,
                "upstream": None,
            })
        else:
            if branch not in local_names:
                remote_candidate = branch if branch.startswith("origin/") else f"origin/{branch}"
                if remote_candidate in remote_names:
                    local_branch = remote_candidate[len("origin/"):]
                    branch = local_branch
                    if local_branch not in local_names:
                        repo["branches"].append({
                            "name": local_branch,
                            "isCurrent": True,
                            "isRemote": False,
                            "upstream": remote_candidate,
                        })
                else:
                    return (404, {"error": f"pathspec '{branch}' did not match any branch"})

        for item in repo["branches"]:
            item["isCurrent"] = (not item["isRemote"]) and item["name"] == branch
        repo["branch"] = branch
        pr = _SIM_PR_BY_BRANCH.get(branch)
        repo["pr"] = dict(pr) if pr else None
        _sim_sync_worktree_descriptor(server, repo_path)
        return (200, {"ok": True, "branch": branch})


def sim_git_discard(server: SimulatorVaultServer, body: dict) -> tuple[int, dict]:
    files = body.get("files")
    if not isinstance(files, list) or not files:
        return (400, {"error": "files must be a non-empty array of relative paths"})
    requested_paths = [str(item).strip() for item in files if isinstance(item, str) and item.strip()]
    if not requested_paths:
        return (400, {"error": "files must contain valid relative paths"})

    with server.fixture_lock:
        repo_path, repo = _sim_resolve_git_repo_unlocked(server, body.get("path"))
        if repo is None or repo_path is None:
            return (400, {"error": "directory is not a git repository"})
        target_set = set(requested_paths)
        remaining = []
        discarded = []
        for entry in repo["uncommitted_files"]:
            if entry["path"] in target_set:
                discarded.append(entry["path"])
            else:
                remaining.append(entry)
        if not discarded:
            return (404, {"error": f"file not found in working tree: {requested_paths[0]}"})
        repo["uncommitted_files"] = remaining
        _sim_sync_worktree_descriptor(server, repo_path)
        return (200, {"ok": True, "discarded": discarded})


def sim_git_commit(server: SimulatorVaultServer, body: dict) -> tuple[int, dict]:
    message = body.get("message")
    if not isinstance(message, str) or not message.strip():
        return (400, {"error": "commit message is required"})
    clean_message = message.strip()
    stage_all = body.get("stageAll", True) is not False
    push = bool(body.get("push", False))

    with server.fixture_lock:
        repo_path, repo = _sim_resolve_git_repo_unlocked(server, body.get("path"))
        if repo is None or repo_path is None:
            return (400, {"error": "directory is not a git repository"})

        if stage_all:
            to_commit = list(repo["uncommitted_files"])
            remaining: list[dict] = []
        else:
            to_commit = [f for f in repo["uncommitted_files"] if f.get("staged")]
            remaining = [f for f in repo["uncommitted_files"] if not f.get("staged")]

        if not to_commit:
            return (400, {"error": "nothing to commit"})

        server.sim_commit_counter += 1
        digest = hashlib.sha1(
            f"{repo_path}:{repo['branch']}:{server.sim_commit_counter}:{clean_message}".encode("utf-8")
        ).hexdigest()
        short_sha = digest[:7]
        subject = clean_message.splitlines()[0]
        commit_record = {
            "sha": digest,
            "shortSha": short_sha,
            "subject": subject,
            "author": "Relay Demo",
            "relativeDate": "just now",
            "committedAt": sim_now_iso(),
        }
        repo["commits"].insert(0, commit_record)
        repo["commit_diffs"][digest] = [dict(item, hunks=list(item["hunks"])) for item in to_commit]

        # Fold committed changes into branch committed_files so mode='committed' reflects them.
        by_path = {item["path"]: item for item in repo["committed_files"]}
        for item in to_commit:
            by_path[item["path"]] = dict(item, staged=False, unstaged=False, hunks=list(item["hunks"]))
        repo["committed_files"] = list(by_path.values())
        repo["uncommitted_files"] = remaining
        repo["ahead"] = 0 if push else (repo["ahead"] + 1)
        _sim_sync_worktree_descriptor(server, repo_path)
        return (
            200,
            {
                "ok": True,
                "sha": digest,
                "shortSha": short_sha,
                "branch": repo["branch"],
                "pushed": push,
            },
        )


def sim_worktree_list(server: SimulatorVaultServer, query: dict) -> tuple[int, dict]:
    requested = (query.get("path", [""])[0] or "").strip()
    with server.fixture_lock:
        project_root = _sim_resolve_project_root_unlocked(server, requested)
        if project_root is None:
            return (200, {"repoRoot": None, "worktrees": []})
        for wt in server.sim_worktrees.get(project_root, []):
            _sim_sync_worktree_descriptor(server, wt["path"])
        return (
            200,
            {
                "repoRoot": project_root,
                "worktrees": [dict(wt) for wt in server.sim_worktrees.get(project_root, [])],
            },
        )


def sim_worktree_create(server: SimulatorVaultServer, body: dict) -> tuple[int, dict]:
    raw_project = body.get("projectPath") or body.get("path")
    action = str(body.get("action") or "branch-off").strip().lower()
    if action not in {"branch-off", "checkout"}:
        return (400, {"error": "action must be branch-off or checkout"})

    with server.fixture_lock:
        project_root = _sim_resolve_project_root_unlocked(server, raw_project)
        if project_root is None:
            return (400, {"error": "directory is not a git repository"})

        existing = server.sim_worktrees.setdefault(project_root, [])
        existing_paths = {wt["path"] for wt in existing}
        existing_branches = {wt["branch"] for wt in existing if wt.get("branch")}

        raw_name = body.get("name")
        raw_branch = body.get("branch")
        raw_base = body.get("baseBranch")
        requested_slug = _sim_slugify_worktree(raw_name) if isinstance(raw_name, str) and raw_name.strip() else None

        if action == "checkout":
            if not isinstance(raw_branch, str) or not raw_branch.strip():
                return (400, {"error": "branch is required"})
            branch = raw_branch.strip()
            if branch in existing_branches:
                return (409, {"error": f"branch {branch} is already checked out in another worktree"})
            base_slug = requested_slug or _sim_slugify_worktree(branch) or f"wt-{len(existing) + 1}"
        else:
            if isinstance(raw_branch, str) and raw_branch.strip():
                desired_branch = raw_branch.strip()
            elif requested_slug:
                desired_branch = requested_slug
            else:
                desired_branch = f"wt-{len(existing) + 1:02d}"
            branch = desired_branch
            suffix = 2
            while branch in existing_branches:
                branch = f"{desired_branch}-{suffix}"
                suffix += 1
            base_slug = requested_slug or _sim_slugify_worktree(branch) or f"wt-{len(existing) + 1}"

        slug = base_slug
        wt_path = f"{project_root}/.relay/worktrees/{slug}"
        suffix = 2
        while wt_path in existing_paths:
            slug = f"{base_slug}-{suffix}"
            wt_path = f"{project_root}/.relay/worktrees/{slug}"
            suffix += 1

        base_branch = raw_base.strip() if isinstance(raw_base, str) and raw_base.strip() else "main"
        parent_repo = server.sim_git_repos.get(project_root)
        head_sha = parent_repo["commits"][0]["sha"] if parent_repo and parent_repo["commits"] else "9f4e2a1b8c3d7e6f0a1b2c3d4e5f6a7b8c9d0e1f"

        new_repo = _sim_make_git_repo_state(
            wt_path,
            branch=branch,
            base_branch=base_branch,
            ahead=0,
            behind=0,
            uncommitted_files=[],
            committed_files=[],
            pr=_SIM_PR_BY_BRANCH.get(branch),
        )
        server.sim_git_repos[wt_path] = new_repo

        descriptor = {
            "path": wt_path,
            "name": slug,
            "head": head_sha,
            "branch": branch,
            "isMain": False,
            "isManaged": True,
            "dirty": False,
            "added": 0,
            "deleted": 0,
        }
        existing.append(descriptor)
        return (201, {"worktree": dict(descriptor)})


def sim_worktree_remove(server: SimulatorVaultServer, body: dict) -> tuple[int, dict]:
    raw_path = body.get("path")
    if not isinstance(raw_path, str) or not raw_path.strip():
        return (400, {"error": "path is required"})
    target_path = _sim_norm_path(raw_path)
    force = bool(body.get("force", False))

    with server.fixture_lock:
        for project_root, entries in server.sim_worktrees.items():
            for index, wt in enumerate(entries):
                if wt["path"] != target_path:
                    continue
                if wt.get("isMain"):
                    return (403, {"error": "cannot remove the main checkout"})
                if not wt.get("isManaged"):
                    return (403, {"error": "cannot remove non-managed worktree outside .relay/worktrees"})
                _sim_sync_worktree_descriptor(server, target_path)
                if wt.get("dirty") and not force:
                    return (409, {"error": "worktree has uncommitted changes"})
                entries.pop(index)
                server.sim_git_repos.pop(target_path, None)
                return (200, {"ok": True, "removed": target_path})
        return (403, {"error": "cannot remove non-managed worktree outside .relay/worktrees"})


def sim_workspace_for_worktree_path(server: SimulatorVaultServer, raw_path: str) -> dict | None:
    target = _sim_norm_path(raw_path)
    if not target:
        return None
    with server.fixture_lock:
        for project_root, entries in server.sim_worktrees.items():
            project_ws = next((w for w in _SIM_WORKSPACES if w["path"] == project_root), None)
            project_name = project_ws["name"] if project_ws else Path(project_root).name
            for wt in entries:
                if wt["path"] == target and not wt.get("isMain"):
                    wt_id = f"wt-{Path(project_root).name}-{wt['name']}"
                    return {
                        "id": wt_id,
                        "name": f"{project_name} · {wt['name']}",
                        "path": wt["path"],
                    }
    return None


def sim_worktree_fs_list(server: SimulatorVaultServer, requested: str, query: dict) -> dict | None:
    target = _sim_norm_path(requested)
    if "/.relay/worktrees/" not in target:
        return None
    prefix, _, rest = target.partition("/.relay/worktrees/")
    parts = [p for p in rest.split("/") if p]
    if not parts:
        return None
    wt_slug = parts[0]
    wt_root = f"{prefix}/.relay/worktrees/{wt_slug}"
    sub_rel = "/".join(parts[1:])
    mapped_target = f"{prefix}/{sub_rel}" if sub_rel else prefix
    listing = codex_fixture_fs_list(mapped_target, query)
    if listing is None:
        return None
    listing = dict(listing)
    listing["absolutePath"] = target
    listing["currentPath"] = target
    rewritten_entries = []
    for entry in listing.get("entries", []):
        copied = dict(entry)
        abs_path = copied.get("absolutePath", "")
        if abs_path.startswith(prefix + "/"):
            copied["absolutePath"] = wt_root + abs_path[len(prefix):]
        rewritten_entries.append(copied)
    listing["entries"] = rewritten_entries
    wt_workspace = sim_workspace_for_worktree_path(server, wt_root)
    if wt_workspace:
        listing["workspace"] = wt_workspace
    return listing


def sim_resolve_workspace(server: SimulatorVaultServer, workspace_id: str) -> dict | None:
    if not workspace_id:
        return None
    workspace = next((item for item in _SIM_WORKSPACES if item["id"] == workspace_id), None)
    if workspace is not None:
        return workspace
    with server.fixture_lock:
        if workspace_id in server.dynamic_workspaces:
            return server.dynamic_workspaces[workspace_id]
        for project_root, entries in server.sim_worktrees.items():
            project_ws = next((w for w in _SIM_WORKSPACES if w["path"] == project_root), None)
            project_name = project_ws["name"] if project_ws else Path(project_root).name
            for wt in entries:
                wt_id = f"wt-{Path(project_root).name}-{wt['name']}"
                if workspace_id in {wt_id, wt["path"], wt["name"]}:
                    resolved = {
                        "id": wt_id,
                        "name": f"{project_name} · {wt['name']}",
                        "path": wt["path"],
                    }
                    server.dynamic_workspaces[wt_id] = resolved
                    return resolved
    return None


def sim_terminal_prompt(server: SimulatorVaultServer, workspace: dict) -> str:
    ws_path = workspace.get("path") or _SIM_POC_VAULT_MAIN_PATH
    short_dir = Path(ws_path).name or "workspace"
    _, repo = _sim_resolve_git_repo_unlocked(server, ws_path)
    git_segment = ""
    if repo is not None:
        dirty, _, _ = _sim_repo_stats(repo)
        dirty_mark = " \x1b[33m±\x1b[0m" if dirty else ""
        git_segment = f" \x1b[35mgit:(\x1b[1;35m{repo['branch']}\x1b[0;35m)\x1b[0m{dirty_mark}"
    return f"\x1b[1;32mrelay@macbook\x1b[0m \x1b[1;36m{short_dir}\x1b[0m{git_segment} \x1b[1;34m❯\x1b[0m "


def sim_terminal_ls_output(workspace: dict) -> str:
    ws_path = workspace.get("path") or _SIM_POC_VAULT_MAIN_PATH
    base_rel = sim_fs_relative(ws_path.partition("/.relay/worktrees/")[0]) or "poc-vault"
    node = sim_fs_node(base_rel)
    children = (node or {}).get("children", {})
    lines = [f"\x1b[2mtotal {max(8, len(children) * 8)}\x1b[0m"]
    lines.append("\x1b[2mdrwxr-xr-x   8 relay  staff    256 Nov 23 12:18 \x1b[1;34m.\x1b[0m")
    lines.append("\x1b[2mdrwxr-xr-x   5 relay  staff    160 Nov 23 11:02 \x1b[1;34m..\x1b[0m")
    for name, child in sorted(children.items()):
        if child.get("kind") == "dir":
            lines.append(f"\x1b[2mdrwxr-xr-x   4 relay  staff    128 Nov 23 12:14 \x1b[1;36m{name}/\x1b[0m")
        else:
            size = len(sim_fs_content(child))
            color = "\x1b[33m" if name.endswith((".ts", ".swift", ".py")) else "\x1b[37m"
            if name.startswith("."):
                color = "\x1b[2;37m"
            lines.append(f"\x1b[2m-rw-r--r--   1 relay  staff {size:6d} Nov 23 12:18 \x1b[0m{color}{name}\x1b[0m")
    return "\r\n".join(lines) + "\r\n"


def sim_terminal_startup_output(server: SimulatorVaultServer, workspace: dict) -> str:
    prompt = sim_terminal_prompt(server, workspace)
    banner = (
        f"\x1b[1;36m● Relay PTY\x1b[0m \x1b[2m·\x1b[0m \x1b[1m{workspace['name']}\x1b[0m "
        f"\x1b[2m({workspace['path']})\x1b[0m\r\n"
    )
    uname_block = (
        f"{prompt}uname -a\r\n"
        f"\x1b[37mDarwin relay-macbook.local 24.4.0 Darwin Kernel Version 24.4.0: "
        f"arm64 RELEASE_ARM64_T6030\x1b[0m\r\n"
    )
    ls_block = f"{prompt}ls -la\r\n{sim_terminal_ls_output(workspace)}"
    return banner + uname_block + ls_block + prompt


def sim_terminal_run_command(server: SimulatorVaultServer, record: dict, command: str) -> str:
    workspace = record["workspace"]
    ws_path = workspace["path"]
    prompt = sim_terminal_prompt(server, workspace)
    stripped = command.strip()

    if not stripped:
        return prompt
    if stripped in {"exit", "logout"}:
        now = sim_now_iso()
        record["terminal"].update({
            "status": "exited",
            "updatedAt": now,
            "finishedAt": now,
            "exitCode": 0,
        })
        return "\x1b[2mlogout\x1b[0m\r\n"
    if stripped == "clear":
        return "\x1b[2J\x1b[H" + prompt
    if stripped == "pwd":
        return f"\x1b[36m{ws_path}\x1b[0m\r\n{prompt}"
    if stripped == "whoami":
        return f"relay-demo\r\n{prompt}"
    if stripped == "date":
        return f"{datetime.now(timezone.utc).strftime('%a %b %d %H:%M:%S UTC %Y')}\r\n{prompt}"
    if stripped == "uname" or stripped.startswith("uname "):
        if "-a" in stripped:
            return (
                "Darwin relay-macbook.local 24.4.0 Darwin Kernel Version 24.4.0: "
                f"arm64 RELEASE_ARM64_T6030\r\n{prompt}"
            )
        return f"Darwin\r\n{prompt}"
    if stripped in {"ls", "ll"} or stripped.startswith("ls "):
        return sim_terminal_ls_output(workspace) + prompt
    if stripped.startswith("echo "):
        return f"{stripped[5:]}\r\n{prompt}"
    if stripped in {"git status", "git st"}:
        _, repo = _sim_resolve_git_repo_unlocked(server, ws_path)
        if repo is None:
            return f"\x1b[31mfatal: not a git repository\x1b[0m\r\n{prompt}"
        out = [f"On branch \x1b[1;36m{repo['branch']}\x1b[0m"]
        if repo["ahead"]:
            out.append(f"Your branch is ahead of 'origin/{repo['baseBranch']}' by {repo['ahead']} commit(s).")
        if not repo["uncommitted_files"]:
            out.append("\x1b[32mnothing to commit, working tree clean\x1b[0m")
        else:
            out.append("")
            out.append("Changes not staged for commit:")
            for item in repo["uncommitted_files"]:
                out.append(f"\t\x1b[31m{item['status']}:   {item['path']}\x1b[0m  \x1b[32m+{item['added']}\x1b[0m \x1b[31m-{item['deleted']}\x1b[0m")
        return "\r\n".join(out) + "\r\n" + prompt
    if stripped == "git branch" or stripped.startswith("git branch "):
        _, repo = _sim_resolve_git_repo_unlocked(server, ws_path)
        if repo is None:
            return f"\x1b[31mfatal: not a git repository\x1b[0m\r\n{prompt}"
        lines = []
        for item in repo["branches"]:
            if item["isRemote"]:
                continue
            if item["isCurrent"]:
                lines.append(f"\x1b[1;32m* {item['name']}\x1b[0m")
            else:
                lines.append(f"  {item['name']}")
        return "\r\n".join(lines) + "\r\n" + prompt
    if stripped == "git log" or stripped.startswith("git log "):
        _, repo = _sim_resolve_git_repo_unlocked(server, ws_path)
        if repo is None:
            return f"\x1b[31mfatal: not a git repository\x1b[0m\r\n{prompt}"
        lines = [
            f"\x1b[33m{c['shortSha']}\x1b[0m {c['subject']} \x1b[2m({c['relativeDate']})\x1b[0m"
            for c in repo["commits"][:5]
        ]
        return "\r\n".join(lines) + "\r\n" + prompt
    if stripped == "git diff" or stripped.startswith("git diff "):
        _, repo = _sim_resolve_git_repo_unlocked(server, ws_path)
        if repo is None:
            return f"\x1b[31mfatal: not a git repository\x1b[0m\r\n{prompt}"
        if not repo["uncommitted_files"]:
            return prompt
        lines = []
        for item in repo["uncommitted_files"][:2]:
            lines.append(f"\x1b[1mdiff --git a/{item['path']} b/{item['path']}\x1b[0m")
            for hunk in item["hunks"][:1]:
                lines.append(f"\x1b[36m{hunk['header']}\x1b[0m")
                for ln in hunk["lines"][:8]:
                    if ln["kind"] == "add":
                        lines.append(f"\x1b[32m+{ln['text']}\x1b[0m")
                    elif ln["kind"] == "del":
                        lines.append(f"\x1b[31m-{ln['text']}\x1b[0m")
                    else:
                        lines.append(f" {ln['text']}")
        return "\r\n".join(lines) + "\r\n" + prompt
    if stripped == "help":
        return (
            "\x1b[1;36mSimulator commands:\x1b[0m "
            "ls, pwd, uname -a, git status, git branch, git log, git diff, echo, date, whoami, clear, exit\r\n"
            + prompt
        )
    return f"\x1b[2m[simulator]\x1b[0m ran: \x1b[37m{stripped}\x1b[0m\r\n{prompt}"


def sim_terminal_ingest_input(server: SimulatorVaultServer, record: dict, text: str) -> None:
    """Supports both per-keystroke VT100 input (char echo, backspace, ^C, ^L)
    and full-line submits (`command\\n`)."""
    out_parts: list[str] = []
    buf: str = record.get("line_buffer", "")
    i = 0
    n = len(text)
    while i < n:
        ch = text[i]
        # Swallow CSI/SS3 navigation escape sequences (e.g., arrow keys) cleanly.
        if ch == "\x1b" and i + 1 < n and text[i + 1] in {"[", "O"}:
            i += 2
            while i < n and not (0x40 <= ord(text[i]) <= 0x7E):
                i += 1
            i += 1
            continue
        if ch == "\x03":  # Ctrl-C
            buf = ""
            out_parts.append("^C\r\n" + sim_terminal_prompt(server, record["workspace"]))
            i += 1
            continue
        if ch == "\x0c":  # Ctrl-L
            buf = ""
            out_parts.append("\x1b[2J\x1b[H" + sim_terminal_prompt(server, record["workspace"]))
            i += 1
            continue
        if ch in {"\x7f", "\x08"}:  # Backspace
            if buf:
                buf = buf[:-1]
                out_parts.append("\b \b")
            i += 1
            continue
        if ch in {"\r", "\n"}:
            if ch == "\r" and i + 1 < n and text[i + 1] == "\n":
                i += 1
            command = buf
            buf = ""
            out_parts.append("\r\n")
            out_parts.append(sim_terminal_run_command(server, record, command))
            i += 1
            continue
        if ord(ch) >= 32 or ch == "\t":
            buf += ch
            out_parts.append(ch)
        i += 1

    record["line_buffer"] = buf
    if out_parts:
        record["output"] += "".join(out_parts)
        record["sequence"] = int(record.get("sequence", 0)) + 1
        record["version"] = int(record.get("version", 0)) + 1
        record["terminal"]["updatedAt"] = sim_now_iso()


def simulator_signing_key(manifest_dir: Path) -> Path:
    configured = os.environ.get("POC_VAULT_SIM_SIGNING_KEY", "").strip()
    if configured:
        key_path = Path(configured).expanduser()
        if not key_path.is_file():
            raise FileNotFoundError(f"simulator signing key not found: {key_path}")
        return key_path

    operator_key = Path("~/.poc-vault/secrets/signing/manifest-ed25519.key").expanduser()
    if operator_key.is_file():
        return operator_key

    # A simulator fixture must not depend on production operator secrets. Keep a
    # simulator-only Ed25519 seed under ignored build output and let the launcher
    # inject its public key into the Debug build.
    key_path = manifest_dir / "manifest-ed25519.key"
    if not key_path.exists():
        descriptor = os.open(key_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "w", encoding="ascii") as key_file:
            key_file.write(f"{os.urandom(32).hex()}\n")
    return key_path


def refresh_manifest(host: str, port: int) -> None:
    manifest_dir = ROOT / "build" / "simulator"
    manifest_dir.mkdir(parents=True, exist_ok=True)
    manifest_path = manifest_dir / "manifest.json"
    signature_path = manifest_dir / "manifest.sig.json"
    signing_key = simulator_signing_key(manifest_dir)
    base_url = f"http://{host}:{port}/pocs/{{slug}}"

    subprocess.run(
        [
            sys.executable,
            str(ROOT / "ops" / "render-manifest.py"),
            "--pocs-dir",
            str(ROOT / "pocs"),
            "--base-url",
            base_url,
            "-o",
            str(manifest_path),
        ],
        cwd=ROOT,
        check=True,
    )
    subprocess.run(
        [
            sys.executable,
            str(ROOT / "ops" / "sign-manifest.py"),
            str(manifest_path),
            "--key",
            str(signing_key),
            "-o",
            str(signature_path),
        ],
        cwd=ROOT,
        check=True,
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8787)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    refresh_manifest(args.host, args.port)
    server = SimulatorVaultServer((args.host, args.port), Handler)
    print(f"POC Vault simulator server on http://{args.host}:{args.port}")
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
