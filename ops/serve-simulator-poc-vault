#!/usr/bin/env python3
"""Serve a local signed POC Vault manifest and static POCs for iOS Simulator."""

from __future__ import annotations

import argparse
import json
import mimetypes
import re
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote, urlparse


ROOT = Path(__file__).resolve().parents[1]
SLUG_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$")


class SimulatorVaultServer(ThreadingHTTPServer):
    def __init__(self, server_address: tuple[str, int], handler_class: type[BaseHTTPRequestHandler]):
        super().__init__(server_address, handler_class)
        self.manifest_dir = ROOT / "build" / "simulator"
        self.pocs_dir = ROOT / "pocs"


class Handler(BaseHTTPRequestHandler):
    server: SimulatorVaultServer

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        path = unquote(parsed.path)
        query = parsed.query

        if path == "/healthz":
            self.send_bytes(b"ok\n", "text/plain")
            return
        if path.startswith("/v1/codex/"):
            self.serve_codex_fixture(path, query)
            return
        if path == "/manifest.json":
            self.send_file(self.server.manifest_dir / "manifest.json", "application/json")
            return
        if path == "/manifest.sig.json":
            self.send_file(self.server.manifest_dir / "manifest.sig.json", "application/json")
            return
        if path.startswith("/pocs/"):
            self.serve_poc(path)
            return

        self.send_error(404)

    def do_POST(self) -> None:
        parsed = urlparse(self.path)
        path = unquote(parsed.path)
        if path == "/v1/codex/jobs":
            self.send_json({
                "id": "sim-job-running",
                "job": codex_fixture_job(status="running", result=None),
            })
            return
        if path == "/v1/codex/workspaces/select":
            self.send_json(codex_fixture_workspace())
            return
        if path == "/v1/codex/workspaces/create":
            self.send_json(codex_fixture_workspace(id="sim-new-workspace", name="New Workspace", path="/srv/codex-workspaces/new-workspace"))
            return
        self.send_error(404)

    def serve_codex_fixture(self, path: str, query: str) -> None:
        if path == "/v1/codex/health":
            self.send_json({"ok": True, "status": "ok", "message": "Simulator Codex fixture"})
            return
        if path == "/v1/codex/workspaces":
            self.send_json({"workspaces": [codex_fixture_workspace()]})
            return
        if path == "/v1/codex/workspace-dirs":
            workspace = codex_fixture_workspace()
            self.send_json({
                "rootPath": "/srv/codex-workspaces",
                "currentPath": workspace["path"],
                "relativePath": "poc-vault",
                "parentPath": "/srv/codex-workspaces",
                "selectedWorkspace": workspace,
                "entries": [],
            })
            return
        if path == "/v1/codex/jobs":
            self.send_json({"jobs": [codex_fixture_job()]})
            return
        if path == "/v1/codex/sessions":
            self.send_json({"sessions": [codex_fixture_session()]})
            return
        if path == "/v1/codex/threads":
            self.send_json({"threads": [codex_fixture_thread()]})
            return
        if path == "/v1/codex/threads/sim-thread-linear":
            self.send_json(codex_fixture_thread_detail())
            return
        if path == "/v1/codex/jobs/sim-job-linear":
            self.send_json(codex_fixture_job())
            return
        if path == "/v1/codex/jobs/sim-job-running":
            self.send_json(codex_fixture_job(status="running", result=None))
            return
        self.send_error(404)

    def serve_poc(self, path: str) -> None:
        parts = path.strip("/").split("/", 2)
        if len(parts) < 2 or parts[0] != "pocs":
            self.send_error(404)
            return

        slug = parts[1]
        if not SLUG_RE.fullmatch(slug):
            self.send_error(404)
            return

        relative = parts[2] if len(parts) == 3 and parts[2] else "index.html"
        if relative.endswith("/"):
            relative += "index.html"

        candidate = (self.server.pocs_dir / slug / "public" / relative).resolve()
        public_root = (self.server.pocs_dir / slug / "public").resolve()
        if not str(candidate).startswith(str(public_root)) or not candidate.is_file():
            self.send_error(404)
            return

        self.send_file(candidate)

    def send_file(self, path: Path, content_type: str | None = None) -> None:
        if not path.is_file():
            self.send_error(404)
            return
        guessed = content_type or mimetypes.guess_type(path.name)[0] or "application/octet-stream"
        self.send_bytes(path.read_bytes(), guessed)

    def send_bytes(self, payload: bytes, content_type: str) -> None:
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def send_json(self, payload: dict) -> None:
        self.send_bytes(json.dumps(payload).encode("utf-8"), "application/json")

    def log_message(self, format: str, *args: object) -> None:
        sys.stderr.write("sim-vault: " + format % args + "\n")


def codex_fixture_workspace(id: str = "poc-vault", name: str = "POC Vault", path: str = "/srv/codex-workspaces/poc-vault") -> dict:
    return {
        "id": id,
        "name": name,
        "path": path,
        "summary": "Simulator workspace",
        "isDefault": True,
    }


def codex_fixture_session() -> dict:
    return {
        "id": "sim-thread-linear",
        "provider": "codex",
        "workspaceId": "poc-vault",
        "workspaceName": "POC Vault",
        "cwd": "/srv/codex-workspaces/poc-vault",
        "updatedAt": "2026-05-23T13:35:30Z",
    }


def codex_fixture_answer() -> str:
    return "\n".join([
        "I pulled issues assigned to you that were updated in the last 7 days, from May 16 to May 23, 2026. There are 3. None are still open in Linear, so these are the action items I could extract:",
        "",
        "- ENGG-541: Confirm the remaining LMS sync follow-up is already captured in the rollout notes.",
        "- ENGG-542: Check whether the production deploy note needs an owner before the next release.",
        "- ENGG-543: Keep the cleanup item closed unless a new regression appears in the mobile console.",
        "",
        "No active Linear ticket needs a fresh reply right now.",
    ])


def codex_fixture_thread() -> dict:
    return {
        "id": "sim-thread-linear",
        "sessionId": "sim-thread-linear",
        "provider": "codex",
        "workspaceId": "poc-vault",
        "workspaceName": "POC Vault",
        "updatedAt": "2026-05-23T13:35:30Z",
        "jobCount": 1,
        "activeJobCount": 0,
        "lastJobId": "sim-job-linear",
        "lastJobStatus": "succeeded",
        "lastPrompt": "List out all my linear issues for last one week and also carve out my action items from them.",
        "lastResult": codex_fixture_answer()[:220] + "...",
        "hasSessionFile": True,
        "isSmokeTest": False,
    }


def codex_fixture_thread_detail() -> dict:
    return {
        "thread": codex_fixture_thread(),
        "messages": [
            {
                "role": "user",
                "timestamp": "2026-05-23T13:34:00Z",
                "text": "List out all my linear issues for last one week and also carve out my action items from them.",
            },
            {
                "role": "assistant",
                "timestamp": "2026-05-23T13:34:20Z",
                "text": "I am pulling Linear issues.",
            },
            {
                "role": "assistant",
                "timestamp": "2026-05-23T13:34:50Z",
                "text": codex_fixture_answer()[:220] + "...",
            },
        ],
        "jobs": [codex_fixture_job()],
    }


def codex_fixture_job(status: str = "succeeded", result: str | None = None) -> dict:
    result_text = codex_fixture_answer() if result is None and status == "succeeded" else result
    return {
        "id": "sim-job-linear" if status == "succeeded" else "sim-job-running",
        "provider": "codex",
        "status": status,
        "workspaceId": "poc-vault",
        "workspaceName": "POC Vault",
        "prompt": "List out all my linear issues for last one week and also carve out my action items from them.",
        "result": result_text,
        "resultTruncated": False,
        "logsIncluded": "compact",
        "sessionId": "sim-thread-linear",
        "createdAt": "2026-05-23T13:34:00Z",
        "startedAt": "2026-05-23T13:34:02Z",
        "completedAt": None if status == "running" else "2026-05-23T13:35:30Z",
        "updatedAt": "2026-05-23T13:35:30Z",
    }


def refresh_manifest(host: str, port: int) -> None:
    manifest_dir = ROOT / "build" / "simulator"
    manifest_dir.mkdir(parents=True, exist_ok=True)
    manifest_path = manifest_dir / "manifest.json"
    signature_path = manifest_dir / "manifest.sig.json"
    base_url = f"http://{host}:{port}/pocs/{{slug}}"

    subprocess.run(
        [
            sys.executable,
            str(ROOT / "ops" / "render-manifest.py"),
            "--pocs-dir",
            str(ROOT / "pocs"),
            "--base-url",
            base_url,
            "-o",
            str(manifest_path),
        ],
        cwd=ROOT,
        check=True,
    )
    subprocess.run(
        [
            sys.executable,
            str(ROOT / "ops" / "sign-manifest.py"),
            str(manifest_path),
            "-o",
            str(signature_path),
        ],
        cwd=ROOT,
        check=True,
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8787)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    refresh_manifest(args.host, args.port)
    server = SimulatorVaultServer((args.host, args.port), Handler)
    print(f"POC Vault simulator server on http://{args.host}:{args.port}")
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
