    def serve_codex_fs_file(self, query: dict, head_only: bool = False) -> None:
        requested = (query.get("path", [""])[0] or "").strip()
        node = sim_fs_node(requested)
        if node is None or node.get("kind") != "file":
            self.send_json_error(404, "file was not found")
            return
        if node.get("denied"):
            self.send_json_error(403, "file matches the read denylist")
            return

        content = sim_fs_content(node)
        size = len(content)
        mime = node.get("mime", "text/plain; charset=utf-8")
        status = 200
        start = 0
        end = min(size, _SIM_FS_MAX_READ_BYTES) - 1
        range_header = self.headers.get("Range")
        if range_header:
            byte_range = sim_parse_byte_range(range_header, size)
            if byte_range is None:
                self.send_response(416)
                self.send_header("Content-Range", f"bytes */{size}")
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.end_headers()
                return
            status = 206
            start, end = byte_range
            end = min(end, start + _SIM_FS_MAX_READ_BYTES - 1)
        elif size > _SIM_FS_MAX_READ_BYTES:
            status = 206

        body = content[start : end + 1]
        active = mime.startswith("text/html") or mime.startswith("image/svg")
        disposition = "attachment" if active or not node.get("inline", True) else "inline"
        self.send_response(status)
        self.send_header("Content-Type", mime)
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Content-Disposition", f'{disposition}; filename="{requested.rsplit("/", 1)[-1]}"')
        if status == 206:
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.end_headers()
        if not head_only:
            self.wfile.write(body)

    def send_json_error(self, status: int, message: str) -> None:
        payload = json.dumps({"error": message}).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def read_json_body(self) -> dict:
        length = int(self.headers.get("Content-Length") or "0")
        if length <= 0:
            return {}
        try:
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except (json.JSONDecodeError, UnicodeDecodeError):
            return {}

    def serve_poc(self, path: str) -> None:
        parts = path.strip("/").split("/", 2)
        if len(parts) < 2 or parts[0] != "pocs":
            self.send_error(404)
            return

        slug = parts[1]
        if not SLUG_RE.fullmatch(slug):
            self.send_error(404)
            return

        relative = parts[2] if len(parts) == 3 and parts[2] else "index.html"
        if relative.endswith("/"):
            relative += "index.html"

        candidate = (self.server.pocs_dir / slug / "public" / relative).resolve()
        public_root = (self.server.pocs_dir / slug / "public").resolve()
        if not str(candidate).startswith(str(public_root)) or not candidate.is_file():
            self.send_error(404)
            return

        self.send_file(candidate)

    def send_file(self, path: Path, content_type: str | None = None) -> None:
        if not path.is_file():
            self.send_error(404)
            return
        guessed = content_type or mimetypes.guess_type(path.name)[0] or "application/octet-stream"
        self.send_bytes(path.read_bytes(), guessed)

    def send_bytes(self, payload: bytes, content_type: str, status: int = 200) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def send_json(self, payload: dict, status: int = 200) -> None:
        self.send_bytes(json.dumps(payload).encode("utf-8"), "application/json", status=status)

    def log_message(self, format: str, *args: object) -> None:
        sys.stderr.write("sim-vault: " + format % args + "\n")


