#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

parity_args=()
if [[ -n "${MOBILE_PARITY_BASE:-}" ]]; then
  parity_args+=(--base "$MOBILE_PARITY_BASE")
fi

python3 "$repo_root/ops/check-mobile-parity.py" "${parity_args[@]}"

(
  cd "$repo_root/mobile"
  ./gradlew :relay-core:allTests :androidApp:assembleDebug
)

xcodebuild \
  -project "$repo_root/ios/POCVault/POCVault.xcodeproj" \
  -scheme POCVault \
  -destination 'generic/platform=iOS Simulator' \
  CODE_SIGNING_ALLOWED=NO \
  build
